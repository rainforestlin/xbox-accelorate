#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Xbox download CDN selector. DNS address records only.

DOMAINS=/usr/share/xboxaccel/domains
NODES=/usr/share/xboxaccel/nodes.tsv
STATUS=/tmp/xboxaccel.status
RESULTS=/tmp/xboxaccel.results
PARTS=/tmp/xboxaccel.parts
LAST=/tmp/xboxaccel.last
LOCK=/var/run/xboxaccel.lock
CRON_FILE=/etc/crontabs/root
CRON_LINE='*/5 * * * * /usr/sbin/xboxaccel tick # xboxaccel'
CONF_NAME=xboxaccel.conf

log() {
	logger -t xboxaccel "$*"
}

uci_get() {
	uci -q get "xboxaccel.main.$1" 2>/dev/null || true
}

valid_ip() {
	echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	echo "$1" | awk -F. '{
		if (NF != 4) exit 1
		for (i = 1; i <= 4; i++) {
			if ($i ~ /^0[0-9]/) exit 1
			if ($i + 0 > 255) exit 1
		}
		exit 0
	}'
}

valid_host() {
	echo "$1" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' || return 1
	grep -Fxq -- "$1" "$DOMAINS"
}

valid_path() {
	echo "$1" | grep -Eq '^/[A-Za-z0-9._~/-]*$' || return 1
	echo "$1" | grep -q '\.\.' && return 1
	return 0
}

confdir() {
	local cfg dir
	cfg=$(uci -q show dhcp 2>/dev/null | awk -F= '/^dhcp\.[^.]+=dnsmasq$/ { split($1, a, "."); print a[2]; exit }')
	[ -n "$cfg" ] || cfg=default
	dir=$(uci -q get "dhcp.${cfg}.confdir" 2>/dev/null || true)
	[ -n "$dir" ] || dir="/tmp/dnsmasq.${cfg}.d"
	dir=${dir%%,*}
	printf '%s\n' "$dir"
}

setting_mode() {
	local mode
	mode=$(uci_get mode)
	case "$mode" in
		static|dynamic) printf '%s\n' "$mode" ;;
		*) printf '%s\n' static ;;
	esac
}

setting_interval() {
	local n
	n=$(uci_get interval)
	echo "$n" | grep -Eq '^[0-9]+$' || n=30
	[ "$n" -lt 5 ] && n=5
	[ "$n" -gt 1440 ] && n=1440
	printf '%s\n' "$n"
}

setting_margin() {
	local n
	n=$(uci_get margin)
	echo "$n" | grep -Eq '^[0-9]+$' || n=20
	[ "$n" -gt 90 ] && n=90
	printf '%s\n' "$n"
}

sample_host() {
	local host
	host=$(uci_get sample_host)
	[ -n "$host" ] || host=assets1.xboxlive.cn
	if valid_host "$host"; then
		printf '%s\n' "$host"
	else
		printf '%s\n' assets1.xboxlive.cn
	fi
}

sample_path() {
	local path
	path=$(uci_get sample_path)
	[ -n "$path" ] || path=/Z/routing/extraextralarge.txt
	if valid_path "$path"; then
		printf '%s\n' "$path"
	else
		printf '%s\n' /Z/routing/extraextralarge.txt
	fi
}

enabled() {
	[ "$(uci_get enabled)" = "1" ]
}

sample_bytes() {
	local mib
	mib=$(uci_get sample_mib)
	echo "$mib" | grep -Eq '^[0-9]+$' || mib=50
	[ "$mib" -lt 8 ] && mib=8
	[ "$mib" -gt 100 ] && mib=100
	echo $((mib * 1048576 - 1))
}

write_status() {
	local running="$1" reason="$2" active="$3" mode="$4" margin="$5" first=1 en=0
	local tmp ip http bps ms ok bytes group host loc loc_json
	enabled && en=1
	tmp=$(mktemp)
	{
		printf '{"running":%s,"enabled":%s,"time":%s,"mode":"%s","active":"%s","reason":"%s","margin":%s,"results":[' \
			"$running" "$en" "$(date +%s)" "$mode" "$active" "$reason" "$margin"
		if [ -f "$RESULTS" ]; then
			while IFS="$(printf '\t')" read -r ip http bps ms ok bytes group host loc; do
				[ -n "$ip" ] || continue
				[ "$first" = 1 ] || printf ','
				first=0
				loc_json=$(printf '%s' "$loc" | awk 'BEGIN { ORS = "" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); print }')
				printf '{"ip":"%s","http":%s,"bps":%s,"conn_ms":%s,"ok":%s,"bytes":%s,"group":"%s","host":"%s","loc":"%s"}' \
					"$ip" "${http:-0}" "${bps:-0}" "${ms:-0}" "${ok:-0}" "${bytes:-0}" \
					"${group:-manual}" "${host:-}" "$loc_json"
			done < "$RESULTS"
		fi
		printf ']}\n'
	} > "$tmp"
	mv "$tmp" "$STATUS"
	chmod 644 "$STATUS"
}

install_cron() {
	mkdir -p /etc/crontabs
	[ -f "$CRON_FILE" ] || touch "$CRON_FILE"
	if grep -Fxq "$CRON_LINE" "$CRON_FILE" 2>/dev/null; then
		return 0
	fi
	grep -v '# xboxaccel$' "$CRON_FILE" > "${CRON_FILE}.xboxaccel" || true
	echo "$CRON_LINE" >> "${CRON_FILE}.xboxaccel"
	mv "${CRON_FILE}.xboxaccel" "$CRON_FILE"
	/etc/init.d/cron restart >/dev/null 2>&1 || true
}

remove_cron() {
	[ -f "$CRON_FILE" ] || return 0
	grep -q '# xboxaccel$' "$CRON_FILE" 2>/dev/null || return 0
	grep -v '# xboxaccel$' "$CRON_FILE" > "${CRON_FILE}.xboxaccel" || true
	mv "${CRON_FILE}.xboxaccel" "$CRON_FILE"
	/etc/init.d/cron restart >/dev/null 2>&1 || true
}

restart_dns() {
	if ! /etc/init.d/dnsmasq restart >/tmp/xboxaccel.dns.log 2>&1; then
		log "dnsmasq restart failed"
		return 1
	fi
	local i=0
	while [ "$i" -lt 20 ]; do
		if netstat -lntup 2>/dev/null | grep ':53 ' | grep -q dnsmasq; then
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	log "dnsmasq did not resume listening on port 53"
	return 1
}

publish_ip() {
	local ip="$1" dir dest tmp changed=0 domain
	dir=$(confdir)
	mkdir -p "$dir"
	dest="$dir/$CONF_NAME"
	tmp=$(mktemp)
	echo '# generated by xboxaccel' > "$tmp"
	while read -r domain; do
		case "$domain" in
			''|'#'*) continue ;;
		esac
		echo "address=/${domain}/${ip}" >> "$tmp"
	done < "$DOMAINS"
	if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
		rm -f "$tmp"
	else
		mv "$tmp" "$dest"
		chmod 644 "$dest"
		changed=1
	fi
	cur=$(uci_get active_ip)
	if [ "$cur" != "$ip" ]; then
		uci set "xboxaccel.main.active_ip=$ip"
		uci commit xboxaccel
	fi
	if [ "$changed" = 1 ]; then
		restart_dns
	fi
}

retract() {
	local dir dest
	dir=$(confdir)
	dest="$dir/$CONF_NAME"
	[ -f "$dest" ] || return 0
	rm -f "$dest"
	restart_dns
}

list_candidates() {
	uci -q show xboxaccel 2>/dev/null | awk -F= '
		/^xboxaccel\.[^.]+=candidate$/ {
			if (sec != "") print ip "\t" en "\t" name
			split($1, a, ".")
			sec = a[2]
			ip = ""
			en = "1"
			name = ""
			next
		}
		{
			split($1, a, ".")
			if (a[2] != sec || a[3] == "") next
			val = $2
			gsub(/^'\''|'\''$/, "", val)
			if (a[3] == "ip") ip = val
			else if (a[3] == "enabled") en = val
			else if (a[3] == "name") name = val
		}
		END { if (sec != "") print ip "\t" en "\t" name }
	'
}

list_targets() {
	local skip catalog ip loc host group en name
	skip=$(mktemp)
	catalog=$(mktemp)
	list_candidates | while IFS="$(printf '\t')" read -r ip en name; do
		[ "$en" = "0" ] && printf '%s\n' "$ip"
	done > "$skip"
	if [ -f "$NODES" ]; then
		while IFS="$(printf '\t')" read -r ip loc host group; do
			case "$ip" in
				''|'#'*) continue ;;
			esac
			valid_ip "$ip" || continue
			printf '%s\n' "$ip" >> "$catalog"
			en=1
			grep -qxF -- "$ip" "$skip" && en=0
			printf '%s\t%s\t%s\t%s\t%s\n' "$ip" "$loc" "$host" "$group" "$en"
		done < "$NODES"
	fi
	list_candidates | while IFS="$(printf '\t')" read -r ip en name; do
		[ "$en" = "0" ] && continue
		valid_ip "$ip" || continue
		grep -qxF -- "$ip" "$catalog" && continue
		printf '%s\t%s\t%s\t%s\t%s\n' "$ip" "$name" "$(sample_host)" "manual" "1"
	done
	rm -f "$skip" "$catalog"
}

probe_one() {
	local ip="$1" host="$2" path="$3" loc="$4" group="$5" end="$6"
	local line rc http bps conn bytes bps_i ms ok
	line=$(curl -sS -o /dev/null --http1.1 --range "0-${end}" --max-time 15 --connect-timeout 4 \
		--resolve "${host}:80:${ip}" \
		-w '%{http_code} %{speed_download} %{time_connect} %{size_download}' \
		"http://${host}${path}" 2>/dev/null)
	rc=$?
	set -- $line
	http=${1:-000}
	bps=${2:-0}
	conn=${3:-0}
	bytes=${4:-0}
	if [ "$rc" -ne 0 ] && [ "$rc" -ne 28 ]; then
		http=000
		bps=0
		bytes=0
	fi
	http=$(awk -v s="$http" 'BEGIN { printf "%d", s + 0 }')
	bps_i=$(awk -v s="$bps" 'BEGIN { printf "%d", s + 0 }')
	ms=$(awk -v s="$conn" 'BEGIN { printf "%d", (s + 0) * 1000 }')
	bytes=$(awk -v s="$bytes" 'BEGIN { printf "%d", s + 0 }')
	ok=0
	case "$http" in
		200|206) [ "$bytes" -ge 1048576 ] && ok=1 ;;
	esac
	mkdir -p "$PARTS"
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$ip" "$http" "$bps_i" "$ms" "$ok" "$bytes" "$group" "$host" "$loc" > "$PARTS/$ip.new"
	mv "$PARTS/$ip.new" "$PARTS/$ip"
}

collect_parts() {
	local f
	: > "$RESULTS"
	[ -d "$PARTS" ] || return 0
	for f in "$PARTS"/*; do
		[ -f "$f" ] || continue
		cat "$f" >> "$RESULTS"
	done
}

run_probes() {
	local path ip loc nodehost group en n=0 end
	end=$(sample_bytes)
	path=$(sample_path)
	rm -rf "$PARTS"
	mkdir -p "$PARTS"
	: > "$RESULTS"
	while IFS="$(printf '\t')" read -r ip loc nodehost group en; do
		[ "$en" = "0" ] && continue
		valid_ip "$ip" || continue
		probe_one "$ip" "$nodehost" "$path" "$loc" "$group" "$end" &
		n=$((n + 1))
		if [ "$n" -ge 4 ]; then
			wait
			n=0
			collect_parts
			if [ "$(setting_mode)" = "static" ] && enabled; then
				write_status 1 running "$(uci_get static_ip)" static "$(setting_margin)"
			else
				write_status 1 running "$(uci_get active_ip)" "$(setting_mode)" "$(setting_margin)"
			fi
		fi
	done << EOF
$(list_targets)
EOF
	wait
	collect_parts
}

decide() {
	local active="$1" margin="$2" best_ip="" best_bps=0 cur_ok=0 cur_bps=0
	local ip http bps ms ok bytes group host loc
	[ -s "$RESULTS" ] || {
		printf '\t%s\n' no-candidate
		return
	}
	while IFS="$(printf '\t')" read -r ip http bps ms ok bytes group host loc; do
		[ "$ok" = "1" ] || continue
		case "$group" in
			cn1|manual) ;;
			*) continue ;;
		esac
		if [ -z "$best_ip" ] || [ "$bps" -gt "$best_bps" ]; then
			best_ip=$ip
			best_bps=$bps
		fi
		if [ "$ip" = "$active" ]; then
			cur_ok=1
			cur_bps=$bps
		fi
	done < "$RESULTS"
	if [ -z "$best_ip" ]; then
		printf '\t%s\n' no-healthy
		return
	fi
	if [ -z "$active" ] || [ "$cur_ok" != "1" ]; then
		if [ -n "$active" ] && [ "$cur_ok" != "1" ]; then
			printf '%s\t%s\n' "$best_ip" current-dead
		else
			printf '%s\t%s\n' "$best_ip" selected
		fi
		return
	fi
	if [ "$best_ip" = "$active" ]; then
		printf '%s\t%s\n' "$active" kept
		return
	fi
	if awk -v b="$best_bps" -v c="$cur_bps" -v m="$margin" 'BEGIN { exit !(b > c * (100 + m) / 100) }'; then
		printf '%s\t%s\n' "$best_ip" switched
	else
		printf '%s\t%s\n' "$active" kept
	fi
}

cmd_test() {
	local mode margin active decision new_ip reason
	exec 9>"$LOCK"
	flock -n 9 || {
		echo busy
		exit 0
	}
	mode=$(setting_mode)
	margin=$(setting_margin)
	active=$(uci_get active_ip)
	: > "$RESULTS"
	write_status 1 running "$active" "$mode" "$margin"
	run_probes
	mode=$(setting_mode)
	if [ "$mode" = "static" ] && enabled; then
		active=$(uci_get static_ip)
		write_status 0 static "$active" static "$(setting_margin)"
		date +%s > "$LAST"
		log "test kept static active=${active:-none}"
		return 0
	fi
	decision=$(decide "$active" "$margin")
	new_ip=$(printf '%s\n' "$decision" | awk -F '\t' 'NR==1 { print $1 }')
	reason=$(printf '%s\n' "$decision" | awk -F '\t' 'NR==1 { print $2 }')
	if valid_ip "$new_ip"; then
		if [ "$(uci_get active_ip)" != "$new_ip" ]; then
			uci set "xboxaccel.main.active_ip=$new_ip"
			uci commit xboxaccel
		fi
		active=$new_ip
	fi
	if enabled && [ "$mode" = "dynamic" ]; then
		if valid_ip "$new_ip"; then
			publish_ip "$new_ip"
			active=$new_ip
		else
			retract
			active=
			log "no healthy CDN address, DNS override removed"
		fi
	elif enabled && [ "$mode" = "static" ]; then
		active=$(uci_get static_ip)
		reason=static
	fi
	write_status 0 "$reason" "$active" "$mode" "$margin"
	date +%s > "$LAST"
	log "test reason=$reason active=${active:-none}"
}

cmd_tick() {
	local mode interval now last elapsed need
	enabled || exit 0
	mode=$(setting_mode)
	[ "$mode" = "dynamic" ] || exit 0
	interval=$(setting_interval)
	now=$(date +%s)
	last=0
	[ -f "$LAST" ] && last=$(cat "$LAST" 2>/dev/null || echo 0)
	echo "$last" | grep -Eq '^[0-9]+$' || last=0
	elapsed=$((now - last))
	need=$((interval * 60))
	[ "$elapsed" -lt "$need" ] && exit 0
	cmd_test
}

cmd_apply() {
	local mode ip
	mode=$(setting_mode)
	if ! enabled; then
		retract
		remove_cron
		write_status 0 disabled "$(uci_get active_ip)" "$mode" "$(setting_margin)"
		return 0
	fi
	if [ "$mode" = "static" ]; then
		remove_cron
		ip=$(uci_get static_ip)
		if valid_ip "$ip"; then
			publish_ip "$ip"
			write_status 0 static "$ip" static "$(setting_margin)"
		else
			retract
			write_status 0 missing-ip "" static "$(setting_margin)"
		fi
		return 0
	fi
	install_cron
	ip=$(uci_get active_ip)
	if valid_ip "$ip"; then
		publish_ip "$ip"
		write_status 0 kept "$ip" dynamic "$(setting_margin)"
	else
		retract
		write_status 0 missing-ip "" dynamic "$(setting_margin)"
	fi
}

cmd_use() {
	local ip="$1"
	valid_ip "$ip" || {
		echo "invalid ip" >&2
		exit 1
	}
	uci set xboxaccel.main.mode='static'
	uci set xboxaccel.main.enabled='1'
	uci set "xboxaccel.main.static_ip=$ip"
	uci set "xboxaccel.main.active_ip=$ip"
	uci commit xboxaccel
	remove_cron
	# Show the choice before DNS restarts, including while a speed test is running.
	if flock -n "$LOCK" -c true; then
		write_status 0 static "$ip" static "$(setting_margin)"
	else
		write_status 1 running "$ip" static "$(setting_margin)"
	fi
	publish_ip "$ip"
	log "static use $ip"
}

cmd_clear() {
	retract
	remove_cron
	write_status 0 disabled "" "$(setting_mode)" "$(setting_margin)"
}

cmd_preview() {
	local ip="$1" domain
	[ -n "$ip" ] || ip=203.0.113.10
	while read -r domain; do
		case "$domain" in
			''|'#'*) continue ;;
		esac
		echo "address=/${domain}/${ip}"
	done < "$DOMAINS"
}

usage() {
	echo "usage: xboxaccel {apply|clear|test|test-bg|tick|use ip|preview [ip]}"
	exit 1
}

case "${1:-}" in
	apply) cmd_apply ;;
	clear) cmd_clear ;;
	test) cmd_test ;;
	test-bg)
		if start-stop-daemon -S -b -x /usr/sbin/xboxaccel -- test; then
			exit 0
		fi
		/usr/sbin/xboxaccel test >/tmp/xboxaccel.test.log 2>&1 </dev/null &
		exit 0
		;;
	tick) cmd_tick ;;
	use) cmd_use "$2" ;;
	preview) cmd_preview "$2" ;;
	*) usage ;;
esac
