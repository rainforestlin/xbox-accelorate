#!/bin/sh
export PATH="/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"
# Facade for the Xbox CDN selector.
# Callers only use: apply, clear, test, test-bg, tick, use, probe, probe-bg, stop, preview, check, log.
# Selection rules live in /usr/share/xboxaccel/policy.
# Which addresses get measured lives in /usr/share/xboxaccel/roster.

DOMAINS=/usr/share/xboxaccel/domains
NODES=/usr/share/xboxaccel/nodes.tsv
NODES_ONLINE=/tmp/xboxaccel.nodes.tsv
NODES_META=/tmp/xboxaccel.nodes.meta
NODES_URL_DEFAULT='https://raw.githubusercontent.com/rainforestlin/xbox-accelorate/main/src/usr/share/xboxaccel/nodes.tsv'
NODES_URL_BACKUP='https://cdn.jsdelivr.net/gh/rainforestlin/xbox-accelorate@main/src/usr/share/xboxaccel/nodes.tsv'
POLICY=/usr/share/xboxaccel/policy
ROSTER=/usr/share/xboxaccel/roster
STATUS=/tmp/xboxaccel.status
RESULTS=/tmp/xboxaccel.results
HISTORY=/tmp/xboxaccel.history
CATALOG=/tmp/xboxaccel.catalog
PARTS=/tmp/xboxaccel.parts
LAST=/tmp/xboxaccel.last
GEN=/tmp/xboxaccel.gen
STOP=/tmp/xboxaccel.stop
SCHEME_FILE=/tmp/xboxaccel.scheme
LOCK=/var/run/xboxaccel.lock
CRON_FILE=/etc/crontabs/root
CRON_LINE='*/5 * * * * /usr/sbin/xboxaccel tick # xboxaccel'
CONF_NAME=xboxaccel.conf
LOG=/tmp/xboxaccel.log
CONN_LOG=/tmp/xboxaccel.redirect.log
# Each redirect host gets its own fake IPv4 alias from REDIR_NET. nft sends
# port 80 to the local 302 listener and DNATs port 443 to the real origin.
REDIR_NET_DEFAULT=198.51.100.0/24
LEGACY_REDIR_IP=198.18.88.80
REDIR_MARK='# xboxaccel redirect'
REDIR_PORT=8079
REDIR_WANT=/tmp/xboxaccel.redir.want
REDIR_PID=/var/run/xboxaccel.redir.pid
REDIR_HTTP_PID=/var/run/xboxaccel.uhttpd.pid
REDIR_DEVS=/tmp/xboxaccel.redir.devs
REDIR_LOG=/tmp/xboxaccel.redir.log
REDIR_MAP=/tmp/xboxaccel.redirect.map
REDIR_ORIGINS=/tmp/xboxaccel.origins
REFRESH_CRON='17 */6 * * * /usr/sbin/xboxaccel refresh # xboxaccel'
# The legacy CDN (XboxOne-era cn2 nodes) does not carry /Z/routing/extraextralarge.txt.
# This is one of the public cn2 sample files used by XboxDownload's speed test.
LEGACY_SAMPLE=/public/content/0044aef3-bd7e-4478-8782-6191546dcd9a/f6585e19-765c-49c3-ba77-326c3766e05a/1.0.4.0.60281fce-b9c0-49f6-a2b6-027abad22637/ACBF_1.0.4.0_x64__b6krnev7r9sf8

log() {
	local lines
	logger -t xboxaccel "$*" 2>/dev/null || true
	printf '%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG" 2>/dev/null || return 0
	lines=$(awk 'END { print NR + 0 }' "$LOG" 2>/dev/null || echo 0)
	[ "$lines" -le 300 ] && return 0
	tail -n 200 "$LOG" > "$LOG.part" 2>/dev/null && mv "$LOG.part" "$LOG"
}

# Copy older syslog lines into the plugin journal once.
# Later reads stay on this file, so the page never opens the system log.
seed_log() {
	local seeded
	[ -f "$LOG.seed" ] && return 0
	: > "$LOG.seed"
	command -v logread >/dev/null 2>&1 || return 0
	seeded=$(mktemp) || return 0
	logread -e 'xboxaccel' 2>/dev/null | awk '
		BEGIN {
			m["Jan"]="01"; m["Feb"]="02"; m["Mar"]="03"; m["Apr"]="04"
			m["May"]="05"; m["Jun"]="06"; m["Jul"]="07"; m["Aug"]="08"
			m["Sep"]="09"; m["Oct"]="10"; m["Nov"]="11"; m["Dec"]="12"
		}
		{
			i = index($0, "xboxaccel")
			if (i == 0) next
			rest = substr($0, i)
			c = index(rest, ":")
			if (c == 0) next
			msg = substr(rest, c + 1)
			sub(/^[[:space:]]+/, "", msg)
			if (msg == "") next
			mon = m[$2]
			if (mon == "") next
			day = $3 + 0
			if (day < 10) day = "0" day
			printf "%s-%s-%s %s\t%s\n", $5, mon, day, $4, msg
		}
	' > "$seeded" || { rm -f "$seeded"; return 0; }
	if [ -s "$LOG" ]; then
		awk -F '\t' 'NR==FNR { if ($2 != "") seen[$2] = 1; next } !seen[$2]' "$LOG" "$seeded" > "$LOG.merge" || true
		cat "$LOG" >> "$LOG.merge"
		mv "$LOG.merge" "$LOG"
	elif [ -s "$seeded" ]; then
		mv "$seeded" "$LOG"
	fi
	rm -f "$seeded" "$LOG.merge"
}

uci_get() {
	uci -q get "xboxaccel.main.$1" 2>/dev/null || true
}

has_opt() {
	uci -q show xboxaccel.main 2>/dev/null | grep -q "^xboxaccel.main.$1="
}

valid_ip() {
	echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	echo "$1" | awk -F. '{
		if (NF != 4) exit 1
		for (i = 1; i <= 4; i++) {
			if ($i !~ /^[0-9]+$/) exit 1
			if ($i ~ /^0[0-9]/) exit 1
			if ($i + 0 > 255) exit 1
		}
		exit 0
	}'
}

public_ipv4() {
	valid_ip "$1" || return 1
	case "$1" in
		0.*|10.*|127.*|169.254.*|192.168.*|255.*) return 1 ;;
		172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 1 ;;
		100.6[4-9].*|100.[7-9][0-9].*|100.1[0-1][0-9].*|100.12[0-7].*) return 1 ;;
		22[4-9].*|23[0-9].*|24[0-9].*|25[0-5].*) return 1 ;;
	esac
}

valid_host() {
	echo "$1" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$' || return 1
	awk -F '\t' -v host="$1" '$1 == host { found = 1 } END { exit !found }' "$DOMAINS"
}

valid_path() {
	echo "$1" | grep -Eq '^/[A-Za-z0-9._~/-]*$' || return 1
	echo "$1" | grep -q '\.\.' && return 1
	return 0
}

confdir() {
	local cfg dir
	cfg=$(uci -q show dhcp 2>/dev/null | awk -F= '/^dhcp\.[^.]+=dnsmasq$/ { split($1, a, "."); print a[2]; exit }')
	[ -n "$cfg" ] || cfg=default
	dir=$(uci -q get "dhcp.${cfg}.confdir" 2>/dev/null || true)
	[ -n "$dir" ] || dir="/tmp/dnsmasq.${cfg}.d"
	dir=${dir%%,*}
	printf '%s\n' "$dir"
}

setting_mode() {
	local mode
	mode=$(uci_get mode)
	case "$mode" in
		static|dynamic) printf '%s\n' "$mode" ;;
		*) printf '%s\n' static ;;
	esac
}

setting_interval() {
	local n
	n=$(uci_get interval)
	case "$n" in ''|*[!0-9]*) n=30 ;; esac
	[ "$n" -lt 5 ] && n=5
	[ "$n" -gt 1440 ] && n=1440
	printf '%s\n' "$n"
}

setting_margin() {
	local n
	n=$(uci_get margin)
	case "$n" in ''|*[!0-9]*) n=20 ;; esac
	[ "$n" -gt 90 ] && n=90
	printf '%s\n' "$n"
}

setting_mib() {
	local n
	n=$(uci_get sample_mib)
	case "$n" in ''|*[!0-9]*) n=50 ;; esac
	[ "$n" -lt 8 ] && n=8
	[ "$n" -gt 100 ] && n=100
	printf '%s\n' "$n"
}

setting_carrier() {
	local carrier
	carrier=$(uci_get carrier)
	case "$carrier" in
		any|telecom|unicom|mobile) printf '%s\n' "$carrier" ;;
		*) printf '%s\n' any ;;
	esac
}

setting_pin() {
	if [ "$(uci_get pin_global)" = "0" ]; then
		printf '0\n'
	else
		printf '1\n'
	fi
}

setting_scheme() {
	case "$(uci_get probe_scheme)" in
		com) printf 'com\n' ;;
		*) printf 'cn\n' ;;
	esac
}

setting_ipv6_mode() {
	case "$(uci_get ipv6_mode)" in
		off) printf 'off\n' ;;
		*) printf 'block\n' ;;
	esac
}

setting_redirect_net() {
	local net
	net=$(uci_get redirect_net)
	valid_redirect_net "$net" && printf '%s\n' "$net" || printf '%s\n' "$REDIR_NET_DEFAULT"
}

valid_redirect_net() {
	local net="$1" base first
	echo "$net" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}/24$' || return 1
	base=${net%/24}
	valid_ip "$base" || return 1
	[ "${base##*.}" = "0" ] || return 1
	first=${base%%.*}
	[ "$first" -ge 1 ] && [ "$first" -le 223 ] || return 1
	return 0
}

redirect_net_overlaps_lan() {
	local net="$1" base dev
	base=${net%/24}
	base=${base%.*}
	for dev in $(lan_devs 2>/dev/null); do
		[ -n "$dev" ] || continue
		ip -4 addr show dev "$dev" 2>/dev/null | awk -v p="$base" '
			$1 == "inet" {
				split($2, a, "/")
				split(a[1], x, ".")
				split(p, y, ".")
				if (x[1] == y[1] && x[2] == y[2] && x[3] == y[3]) found = 1
			}
			END { exit !found }
		' && return 0
	done
	return 1
}

setting_origin_ttl() {
	local n
	n=$(uci_get origin_ttl)
	case "$n" in ''|*[!0-9]*) n=21600 ;; esac
	[ "$n" -lt 300 ] && n=300
	[ "$n" -gt 604800 ] && n=604800
	printf '%s\n' "$n"
}

setting_nodes_url() {
	local url
	url=$(uci_get nodes_url)
	printf '%s\n' "${url:-$NODES_URL_DEFAULT}"
}

setting_nodes_backup() {
	local url
	url=$(uci_get nodes_url_backup)
	printf '%s\n' "${url:-$NODES_URL_BACKUP}"
}

nodes_file() {
	if [ -s "$NODES_ONLINE" ]; then
		printf '%s\n' "$NODES_ONLINE"
	else
		printf '%s\n' "$NODES"
	fi
}

node_row() {
	awk -F '\t' -v ip="$1" '$1 == ip { print $2 "\t" $3 "\t" $4; exit }' "$(nodes_file)"
}

nodes_validate() {
	awk -F '\t' -v domains="$DOMAINS" '
		function validip(ip, a, n, i) {
			if (ip !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) return 0
			n = split(ip, a, ".")
			if (n != 4) return 0
			for (i = 1; i <= 4; i++) {
				if (a[i] ~ /^0[0-9]/ || a[i] + 0 > 255) return 0
			}
			if (a[1] == 0 || a[1] == 10 || a[1] == 127 || a[1] == 255) return 0
			if (a[1] == 169 && a[2] == 254) return 0
			if (a[1] == 192 && a[2] == 168) return 0
			if (a[1] == 172 && a[2] >= 16 && a[2] <= 31) return 0
			if (a[1] == 100 && a[2] >= 64 && a[2] <= 127) return 0
			if (a[1] >= 224) return 0
			return 1
		}
		BEGIN {
			while ((getline line < domains) > 0) {
				split(line, a, "\t")
				if (a[1] != "" && a[1] !~ /^#/) okhost[a[1]] = 1
			}
		}
		{
			if ($0 == "" || $1 ~ /^#/) next
			if (NF < 4) { bad++; next }
			ip = $1
			gsub(/^[ \t]+|[ \t]+$/, "", ip)
			host = $3
			gsub(/^[ \t]+|[ \t]+$/, "", host)
			group = $4
			gsub(/^[ \t]+|[ \t]+$/, "", group)
			if (!validip(ip) || !(host in okhost) || (group != "cn1" && group != "cn2") || $2 == "") {
				bad++
				next
			}
			if (seen[ip]++) next
			print ip "\t" $2 "\t" host "\t" group
			good++
		}
		END {
			if (good < 10 || bad > good) exit 1
		}
	' "$1"
}

nodes_update() {
	local arg="$1" url backup tmp valid sha meta now good
	url=${arg:-$(setting_nodes_url)}
	backup=$(setting_nodes_backup)
	tmp=$(mktemp) || return 1
	valid=$(mktemp) || { rm -f "$tmp"; return 1; }
	meta=$(mktemp) || { rm -f "$tmp" "$valid"; return 1; }
	if ! curl -q -fsS --proto '=https' --tlsv1.2 --max-time 8 --max-filesize 524288 \
		-H 'Cache-Control: no-cache' -o "$tmp" "$url"; then
		if ! curl -q -fsS --proto '=https' --tlsv1.2 --max-time 8 --max-filesize 524288 \
			-H 'Cache-Control: no-cache' -o "$tmp" "$backup"; then
			log "节点列表下载失败"
			rm -f "$tmp" "$valid" "$meta"
			return 1
		fi
		url=$backup
	fi
	if ! nodes_validate "$tmp" > "$valid"; then
		log "节点列表格式校验失败"
		rm -f "$tmp" "$valid" "$meta"
		return 1
	fi
	sha=$(uci_get nodes_sha256)
	if [ -n "$sha" ]; then
		good=$(sha256sum "$tmp" | awk '{ print $1 }')
		if [ "$good" != "$sha" ]; then
			log "节点列表校验和不匹配"
			rm -f "$tmp" "$valid" "$meta"
			return 1
		fi
	fi
	good=$(awk 'END { print NR + 0 }' "$valid")
	now=$(date +%s)
	mv "$valid" "$NODES_ONLINE" || { rm -f "$tmp" "$valid" "$meta"; return 1; }
	printf '%s\t%s\t%s\t%s\n' "$now" "$url" "$good" "${sha:-none}" > "$meta"
	mv "$meta" "$NODES_META"
	rm -f "$tmp"
	log "节点列表已更新：${good} 条（${url}）"
	return 0
}

cmd_nodes_update() {
	exec 9>"$LOCK"
	flock -n 9 || {
		echo busy
		exit 0
	}
	if nodes_update "$1"; then
		nodes_status
	else
		echo failed
		exit 1
	fi
}

cmd_nodes_status() {
	if [ -s "$NODES_ONLINE" ] && [ -s "$NODES_META" ]; then
		IFS="$(printf '\t')" read -r ts url count sha < "$NODES_META"
		printf 'source\tcache\nupdated\t%s\nurl\t%s\ncount\t%s\nsha\t%s\n' \
			"$(date -d "@${ts:-0}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$ts")" "$url" "$count" "$sha"
	else
		printf 'source\tbuiltin\nupdated\t\nurl\t%s\ncount\t%s\nsha\tnone\n' \
			"$(setting_nodes_url)" "$(awk 'END { print NR + 0 }' "$NODES" 2>/dev/null)"
	fi
}

cmd_nodes_clear() {
	rm -f "$NODES_ONLINE" "$NODES_META"
	log "已恢复内置节点列表"
}

nodes_status() {
	cmd_nodes_status
}


origin_resolvers() {
	{
		printf '%s\n' $(uci_get origin_dns | tr ',' ' ')
		if [ -r /tmp/resolv.conf.d/resolv.conf.auto ]; then
			awk '/^nameserver / { print $2 }' /tmp/resolv.conf.d/resolv.conf.auto
		fi
		printf '%s\n' 223.5.5.5 119.29.29.29 1.1.1.1
	} | awk 'NF && $0 !~ /^127\./ && $0 !~ /:/ && !seen[$0]++'
}

usable_origin_ipv4() {
	local net base
	public_ipv4 "$1" || return 1
	case "$1" in
		198.18.*|198.19.*|192.0.2.*|198.51.100.*|203.0.113.*) return 1 ;;
	esac
	net=${REDIR_NET_CURRENT:-$(setting_redirect_net)}
	base=${net%/24}
	base=${base%.*}
	case "$1" in
		"${base}."*) return 1 ;;
	esac
	return 0
}

origin_lookup() {
	local host="$1" server="$2" ip
	dns_lookup a "$host" "$server"
	awk '/^Server:/ { srv = 1; next }
		/^Addresses:/ { if (srv) { srv = 0; next } print $2; plural = 1; next }
		/^Address:/ { if (srv) { srv = 0; next } print $2; plural = 0; next }
		/^[ \t]+[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/ { if (plural) print $1 }' /tmp/xboxaccel.lookup |
	while IFS= read -r ip; do
		usable_origin_ipv4 "$ip" && {
			printf '%s\n' "$ip"
			break
		}
	done
}

cache_origin() {
	local host="$1" origin="$2" now="$3" tmp
	tmp=$(mktemp) || return 1
	if [ -f "$REDIR_ORIGINS" ]; then
		awk -F '\t' -v h="$host" '$1 != h' "$REDIR_ORIGINS" > "$tmp"
	fi
	printf '%s\t%s\t%s\n' "$host" "$origin" "$now" >> "$tmp"
	mv "$tmp" "$REDIR_ORIGINS"
}

resolve_origin() {
	local host="$1" now ts old origin server
	now=$(date +%s)
	ts=
	old=
	if [ -s "$REDIR_ORIGINS" ]; then
		while IFS="$(printf '\t')" read -r h o t; do
			[ "$h" = "$host" ] || continue
			old=$o
			ts=$t
			break
		done < "$REDIR_ORIGINS"
	fi
	if [ -n "$old" ] && [ -n "$ts" ] && [ $((now - ts)) -lt "$(setting_origin_ttl)" ]; then
		printf '%s\n' "$old"
		return 0
	fi
	for server in $(origin_resolvers); do
		origin=$(origin_lookup "$host" "$server")
		[ -n "$origin" ] && break
	done
	if [ -n "$origin" ]; then
		cache_origin "$host" "$origin" "$now"
		printf '%s\n' "$origin"
		return 0
	fi
	if [ -n "$old" ]; then
		cache_origin "$host" "$old" "$now"
		printf '%s\n' "$old"
		return 0
	fi
	return 1
}

redirect_map_alias() {
	awk -F '\t' -v h="$1" '$1 == h { print $2; exit }' "$REDIR_MAP" 2>/dev/null
}

build_redirect_map() {
	local primary="$1" legacy="$2" pin="$3"
	local net base host pool edge extra ip origin alias n=0 https=0 missing=0 tmp
	[ "$pin" = 1 ] || return 1
	net=$(setting_redirect_net)
	valid_redirect_net "$net" || {
		log "跳转地址段无效：$net"
		return 1
	}
	if redirect_net_overlaps_lan "$net"; then
		log "跳转地址段和局域网重叠：$net"
		return 1
	fi
	base=${net%/24}
	base=${base%.*}
	REDIR_NET_CURRENT=$net
	log "正在解析跳转源站（${net}）"
	tmp=$(mktemp) || return 1
	while IFS="$(printf '\t')" read -r host pool edge extra; do
		case "$host" in
			''|'#'*) continue ;;
		esac
		case "$edge" in
			global|hop|alias) ;;
			*) continue ;;
		esac
		case "$pool" in
			primary) ip=$primary ;;
			legacy) ip=$legacy ;;
			*) continue ;;
		esac
		public_ipv4 "$ip" || continue
		if [ "$edge" = alias ]; then
			origin=-
		else
			origin=$(resolve_origin "$host")
			if [ -z "$origin" ]; then
				missing=$((missing + 1))
				log "源站解析失败，跳过 $host"
				continue
			fi
		fi
		n=$((n + 1))
		if [ "$n" -gt 254 ]; then
			log "跳转别名超过 254 个，跳过剩余 host"
			break
		fi
		alias="${base}.${n}"
		printf '%s\t%s\t%s\n' "$host" "$alias" "$origin" >> "$tmp"
		[ "$origin" = "-" ] || https=$((https + 1))
	done < "$DOMAINS"
	if [ ! -s "$tmp" ]; then
		rm -f "$tmp"
		log "没有可用的跳转 host"
		return 1
	fi
	mv "$tmp" "$REDIR_MAP"
	REDIRECT_NET_ACTIVE=$net
	ORIGIN_COUNT=$https
	ORIGIN_MISSING=$missing
	log "跳转映射：${n} 个 host，${https} 个 HTTPS 回源，${missing} 个源站解析失败"
	return 0
}

setting_primary() {
	local value
	if has_opt primary_ip; then
		value=$(uci_get primary_ip)
	else
		value=$(uci_get static_ip)
	fi
	public_ipv4 "$value" && printf '%s\n' "$value"
}

setting_legacy() {
	local value
	value=$(uci_get legacy_ip)
	public_ipv4 "$value" && printf '%s\n' "$value"
}

setting_active_primary() {
	local value
	if has_opt active_primary; then
		value=$(uci_get active_primary)
	else
		value=$(uci_get active_ip)
	fi
	public_ipv4 "$value" && printf '%s\n' "$value"
}

setting_active_legacy() {
	local value
	value=$(uci_get active_legacy)
	public_ipv4 "$value" && printf '%s\n' "$value"
}

sample_host() {
	local host
	host=$(uci_get sample_host)
	[ -n "$host" ] || host=assets1.xboxlive.cn
	if valid_host "$host"; then
		printf '%s\n' "$host"
	else
		printf '%s\n' assets1.xboxlive.cn
	fi
}

sample_path() {
	local path
	path=$(uci_get sample_path)
	[ -n "$path" ] || path=/Z/routing/extraextralarge.txt
	if valid_path "$path"; then
		printf '%s\n' "$path"
	else
		printf '%s\n' /Z/routing/extraextralarge.txt
	fi
}

sample_path_legacy() {
	local path
	path=$(uci_get sample_path_legacy)
	[ -n "$path" ] || path=$LEGACY_SAMPLE
	if valid_path "$path"; then
		printf '%s\n' "$path"
	else
		printf '%s\n' "$LEGACY_SAMPLE"
	fi
}

# The selected address is shared by both pools, but the Host header is not:
# a domestic node rejects *.xboxlive.com and xvcf*.xboxlive.cn. Probes must
# always use a name the node actually serves, even when sample_host is a .com.
probe_host() {
	local pool="$1" host
	if [ "$pool" = legacy ]; then
		printf '%s\n' dlassets.xboxlive.cn
		return 0
	fi
	host=$(sample_host)
	case "$host" in
		dlassets.xboxlive.com|dlassets2.xboxlive.com) host=dlassets.xboxlive.cn ;;
		xvcf1.xboxlive.cn|xvcf2.xboxlive.cn) host=assets1.xboxlive.cn ;;
		*.xboxlive.com) host=assets1.xboxlive.cn ;;
		5.xb.delivery.microsoft.com|assets1.xboxlive.com.edgesuite.net|cl-glcb907925.gcdn.co|fg.microsoft.map.fastly.net) host=assets1.xboxlive.cn ;;
	esac
	printf '%s\n' "$host"
}

# The .com speed check goes through the local 302 listener. The redirect
# target is forced to the candidate address, so the comparison uses the same
# node as the direct .cn probe.
probe_com_host() {
	case "$1" in
		dlassets.xboxlive.cn|dlassets2.xboxlive.cn|dlassets.xboxlive.com|dlassets2.xboxlive.com)
			printf '%s\n' dlassets.xboxlive.com
			;;
		*)
			printf '%s\n' assets1.xboxlive.com
			;;
	esac
}

probe_cn_host() {
	case "$1" in
		dlassets.xboxlive.cn|dlassets2.xboxlive.cn|dlassets.xboxlive.com|dlassets2.xboxlive.com)
			printf '%s\n' dlassets.xboxlive.cn
			;;
		*)
			printf '%s\n' assets1.xboxlive.cn
			;;
	esac
}

enabled() {
	[ "$(uci_get enabled)" = "1" ]
}

migrate_uci() {
	local dirty=0
	if ! has_opt primary_ip; then
		uci set "xboxaccel.main.primary_ip=$(uci_get static_ip)"
		dirty=1
	fi
	if ! has_opt legacy_ip; then
		uci set xboxaccel.main.legacy_ip=''
		dirty=1
	fi
	if ! has_opt active_primary; then
		uci set "xboxaccel.main.active_primary=$(uci_get active_ip)"
		dirty=1
	fi
	if ! has_opt active_legacy; then
		uci set xboxaccel.main.active_legacy=''
		dirty=1
	fi
	if ! has_opt carrier; then
		uci set xboxaccel.main.carrier='any'
		dirty=1
	fi
	if ! has_opt pin_global; then
		uci set xboxaccel.main.pin_global='1'
		dirty=1
	fi
	if ! has_opt redirect_net; then
		uci set "xboxaccel.main.redirect_net=$REDIR_NET_DEFAULT"
		dirty=1
	fi
	if ! has_opt origin_dns; then
		uci set xboxaccel.main.origin_dns=''
		dirty=1
	fi
	if ! has_opt origin_ttl; then
		uci set xboxaccel.main.origin_ttl='21600'
		dirty=1
	fi
	if ! has_opt nodes_url; then
		uci set "xboxaccel.main.nodes_url=$NODES_URL_DEFAULT"
		dirty=1
	fi
	if ! has_opt nodes_url_backup; then
		uci set "xboxaccel.main.nodes_url_backup=$NODES_URL_BACKUP"
		dirty=1
	fi
	if ! has_opt nodes_sha256; then
		uci set xboxaccel.main.nodes_sha256=''
		dirty=1
	fi
	if ! has_opt nodes_update_hours; then
		uci set xboxaccel.main.nodes_update_hours='24'
		dirty=1
	fi
	if ! has_opt ipv6_mode; then
		uci set xboxaccel.main.ipv6_mode='block'
		dirty=1
	fi
	[ "$dirty" = 1 ] && uci commit xboxaccel
}

bump_gen() {
	local n
	n=$(cat "$GEN" 2>/dev/null || echo 0)
	case "$n" in ''|*[!0-9]*) n=0 ;; esac
	echo $((n + 1)) > "$GEN"
}

stale() {
	local now
	now=$(cat "$GEN" 2>/dev/null || echo 0)
	[ "$now" != "$gen0" ]
}

install_cron() {
	mkdir -p /etc/crontabs
	[ -f "$CRON_FILE" ] || touch "$CRON_FILE"
	if grep -Fxq "$CRON_LINE" "$CRON_FILE" 2>/dev/null &&
		grep -Fxq "$REFRESH_CRON" "$CRON_FILE" 2>/dev/null; then
		return 0
	fi
	grep -v '# xboxaccel$' "$CRON_FILE" > "${CRON_FILE}.xboxaccel" || true
	echo "$CRON_LINE" >> "${CRON_FILE}.xboxaccel"
	echo "$REFRESH_CRON" >> "${CRON_FILE}.xboxaccel"
	mv "${CRON_FILE}.xboxaccel" "$CRON_FILE"
	/etc/init.d/cron restart >/dev/null 2>&1 || true
}

remove_cron() {
	[ -f "$CRON_FILE" ] || return 0
	grep -q '# xboxaccel$' "$CRON_FILE" 2>/dev/null || return 0
	grep -v '# xboxaccel$' "$CRON_FILE" > "${CRON_FILE}.xboxaccel" || true
	mv "${CRON_FILE}.xboxaccel" "$CRON_FILE"
	/etc/init.d/cron restart >/dev/null 2>&1 || true
}

dns_lookup() {
	local type="$1" host="$2" server="${3:-127.0.0.1}" pid i=0
	nslookup -type="$type" "$host" "$server" >/tmp/xboxaccel.lookup 2>&1 &
	pid=$!
	while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 3 ]; do
		sleep 1
		i=$((i + 1))
	done
	kill "$pid" 2>/dev/null
	wait "$pid" 2>/dev/null
}

dns_up() {
	dns_lookup a localhost
	grep -q '[Aa]ddress' /tmp/xboxaccel.lookup
}

answer_matches() {
	local host="$1" ip="$2" try=0
	# dnsmasq answers only after the restart has finished listening.
	while [ "$try" -lt 8 ]; do
		dns_lookup a "$host"
		if grep -F "$ip" /tmp/xboxaccel.lookup >/dev/null; then
			dns_lookup aaaa "$host"
			if awk '
				$1 ~ /^Address:?$/ {
					v = $2
					if (v ~ /^127\./) next
					if (index(v, ":") && v !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/) exit 1
				}
			' /tmp/xboxaccel.lookup; then
				return 0
			fi
		fi
		try=$((try + 1))
		sleep 1
	done
	cat /tmp/xboxaccel.lookup >> /tmp/xboxaccel.dns.log 2>/dev/null || true
	log "解析没有对上 $host，期望 $ip"
	return 1
}

verify_published() {
	local dest="$1" pairs ip host fail=0
	pairs=$(mktemp) || return 1
	awk -F/ '/^address=\// { print $3 "\t" $2 }' "$dest" | awk -F '\t' '!seen[$1]++' > "$pairs"
	if [ ! -s "$pairs" ]; then
		rm -f "$pairs"
		dns_up
		return $?
	fi
	while IFS="$(printf '\t')" read -r ip host; do
		answer_matches "$host" "$ip" || fail=1
	done < "$pairs"
	rm -f "$pairs"
	[ "$fail" = 0 ]
}

redirect_in() {
	grep -qxF "$REDIR_MARK" "$1" 2>/dev/null
}

share_dir() {
	local dir
	dir=$(CDPATH= cd -- "$(dirname "$0")/../share/xboxaccel" 2>/dev/null && pwd) || true
	if [ -n "$dir" ] && [ -f "$dir/domains" ]; then
		printf '%s\n' "$dir"
		return 0
	fi
	printf '%s\n' /usr/share/xboxaccel
}

proc_matches() {
	local pid="$1" mark="$2" line
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	[ -r "/proc/$pid/cmdline" ] || return 0
	line=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)
	printf '%s' "$line" | grep -q -- "$mark"
}

stop_pid() {
	local pid="$1" mark="$2" i
	proc_matches "$pid" "$mark" || return 0
	kill "$pid" 2>/dev/null || true
	i=0
	while proc_matches "$pid" "$mark" && [ "$i" -lt 5 ]; do
		sleep 1
		i=$((i + 1))
	done
	proc_matches "$pid" "$mark" && kill -9 "$pid" 2>/dev/null || true
}

stop_redirect_procs() {
	local pid
	rm -f "$REDIR_WANT"
	pid=$(cat "$REDIR_PID" 2>/dev/null || true)
	stop_pid "$pid" "redir-run"
	rm -f "$REDIR_PID"
	pid=$(cat "$REDIR_HTTP_PID" 2>/dev/null || true)
	stop_pid "$pid" "$REDIR_PORT"
	rm -f "$REDIR_HTTP_PID"
}

lan_devs() {
	local name dev seen
	seen=$(mktemp) || return 1
	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		for name in $(ubus list 2>/dev/null | sed -n 's/^network\.interface\.//p'); do
			case "$name" in
				wan*|pppoe*|wwan*|modem*|loopback) continue ;;
			esac
			dev=$(ubus call "network.interface.${name}" status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null || true)
			[ -n "$dev" ] || continue
			[ "$dev" = lo ] && continue
			[ -d "/sys/class/net/$dev" ] || continue
			grep -qxF -- "$dev" "$seen" && continue
			printf '%s\n' "$dev" >> "$seen"
		done
	fi
	if [ ! -s "$seen" ]; then
		dev=$(uci -q get network.lan.device 2>/dev/null || true)
		[ -n "$dev" ] || dev=br-lan
		if [ -d "/sys/class/net/$dev" ]; then
			printf '%s\n' "$dev" >> "$seen"
		fi
	fi
	cat "$seen"
	rm -f "$seen"
}

nft_rules() {
	awk -F '\t' -v port="$REDIR_PORT" '
		BEGIN { n = 0; m = 0 }
		{
			a[n++] = $2
			if ($3 != "-" && $3 != "") {
				h[m] = $2
				o[m] = $3
				m++
			}
		}
		END {
			if (n == 0) exit 1
			print "table inet xboxaccel {"
			printf " set redirect_v4 { type ipv4_addr; elements = { "
			for (i = 0; i < n; i++)
				printf "%s%s", (i ? ", " : ""), a[i]
			print " } }"
			if (m > 0) {
				printf " map https4 { type ipv4_addr : ipv4_addr; elements = { "
				for (i = 0; i < m; i++)
					printf "%s%s : %s", (i ? ", " : ""), h[i], o[i]
				print " } }"
			}
			print " chain prerouting {"
			print "  type nat hook prerouting priority dstnat; policy accept;"
			print "  ip daddr @redirect_v4 tcp dport 80 redirect to :" port
			if (m > 0)
				print "  ip daddr @redirect_v4 tcp dport 443 dnat to ip daddr map @https4"
			print " }"
			print " chain output {"
			print "  type nat hook output priority -100; policy accept;"
			print "  ip daddr @redirect_v4 tcp dport 80 redirect to :" port
			if (m > 0)
				print "  ip daddr @redirect_v4 tcp dport 443 dnat to ip daddr map @https4"
			print " }"
			print "}"
		}
	' "$REDIR_MAP"
}

ensure_nft() {
	local tmp create apply
	command -v nft >/dev/null 2>&1 || {
		log "没有 nft，无法建立跳转规则"
		return 1
	}
	[ -s "$REDIR_MAP" ] || {
		log "没有跳转映射"
		return 1
	}
	tmp=$(mktemp) || return 1
	create=$(mktemp) || { rm -f "$tmp"; return 1; }
	apply=$(mktemp) || { rm -f "$tmp" "$create"; return 1; }
	nft_rules > "$tmp" || {
		log "跳转规则生成失败"
		rm -f "$tmp" "$create" "$apply"
		return 1
	}
	cat "$tmp" > "$create"
	{
		echo 'delete table inet xboxaccel'
		cat "$create"
	} > "$apply"
	if ! nft list table inet xboxaccel >/dev/null 2>&1; then
		if ! nft -c -f "$create" >/tmp/xboxaccel.nft.log 2>&1; then
			log "跳转规则校验失败"
			while IFS= read -r line; do log "nft: $line"; done <<EOF
$(tail -n 5 /tmp/xboxaccel.nft.log 2>/dev/null)
EOF
			rm -f "$tmp" "$create" "$apply"
			return 1
		fi
	fi
	if ! nft -f "$apply" >/tmp/xboxaccel.nft.log 2>&1; then
		# The delete fails when the table is absent; create it instead.
		if ! nft -f "$create" >>/tmp/xboxaccel.nft.log 2>&1; then
			log "跳转规则应用失败"
			while IFS= read -r line; do log "nft: $line"; done <<EOF
$(tail -n 5 /tmp/xboxaccel.nft.log 2>/dev/null)
EOF
			rm -f "$tmp" "$create" "$apply"
			return 1
		fi
	fi
	rm -f "$tmp" "$create" "$apply"
	nft list table inet xboxaccel >/dev/null 2>&1
}

redirect_healthy() {
	local hdr
	command -v curl >/dev/null 2>&1 || return 1
	hdr=$(curl -4 -sS -D - -o /dev/null --max-redirs 0 --connect-timeout 1 --max-time 3 \
		-H 'Host: assets1.xboxlive.com' \
		"http://127.0.0.1:${REDIR_PORT}/Z/routing/extraextralarge.txt" 2>/dev/null || true)
	printf '%s\n' "$hdr" | tr -d '\r' | grep -q "assets1.xboxlive.cn/Z/routing/extraextralarge.txt"
}

ensure_http() {
	local i pid run
	if redirect_healthy; then
		return 0
	fi
	if [ ! -x /usr/sbin/uhttpd ] && ! command -v uhttpd >/dev/null 2>&1; then
		log "没有 uhttpd，无法跳转国际域名"
		return 1
	fi
	run=$(share_dir)/redir-run
	[ -f "$run" ] || run=/usr/share/xboxaccel/redir-run
	[ -f "$run" ] || {
		log "缺少跳转程序"
		return 1
	}
	stop_redirect_procs
	: > "$REDIR_WANT"
	: > "$REDIR_LOG"
	if command -v nohup >/dev/null 2>&1; then
		nohup /bin/sh "$run" >>"$REDIR_LOG" 2>&1 &
	else
		/bin/sh "$run" >>"$REDIR_LOG" 2>&1 &
	fi
	pid=$!
	echo "$pid" > "$REDIR_PID"
	i=0
	while [ "$i" -lt 8 ]; do
		redirect_healthy && return 0
		i=$((i + 1))
		sleep 1
	done
	log "跳转服务没有起来"
	if [ -s "$REDIR_LOG" ]; then
		while IFS= read -r line; do
			log "跳转: ${line}"
		done <<EOF
$(tail -n 5 "$REDIR_LOG" 2>/dev/null)
EOF
	fi
	return 1
}

setup_redirect() {
	local was=0
	redirect_healthy && was=1
	if ! ensure_nft || ! ensure_http; then
		return 1
	fi
	if [ "$was" != 1 ]; then
		log "国际域名跳转已启动"
	fi
	return 0
}

teardown_redirect() {
	local dev had=0
	if [ -f "$REDIR_WANT" ] || [ -f "$REDIR_PID" ] || [ -f "$REDIR_DEVS" ]; then
		had=1
	fi
	nft list table inet xboxaccel >/dev/null 2>&1 && had=1
	stop_redirect_procs
	nft delete table inet xboxaccel >/dev/null 2>&1 || true
	# Remove the pre-1.4 single alias if an upgrade left it behind.
	if [ -f "$REDIR_DEVS" ]; then
		while IFS= read -r dev; do
			[ -n "$dev" ] || continue
			ip addr del "${LEGACY_REDIR_IP}/32" dev "$dev" 2>/dev/null || true
		done < "$REDIR_DEVS"
		rm -f "$REDIR_DEVS"
	fi
	for dev in $(lan_devs 2>/dev/null); do
		[ -n "$dev" ] || continue
		ip addr del "${LEGACY_REDIR_IP}/32" dev "$dev" 2>/dev/null || true
	done
	if [ "$had" = 1 ]; then
		log "国际域名跳转已停止"
	fi
	return 0
}

finish_redirect() {
	local dest="$1"
	if redirect_in "$dest"; then
		return 0
	fi
	teardown_redirect
	return 0
}

render_dns() {
	local primary="$1" legacy="$2" pin="$3" dest="$4"
	local host pool edge ip have_primary=0 have_legacy=0 srv map_ip redirect=0 ipv6_mode
	public_ipv4 "$primary" && have_primary=1
	public_ipv4 "$legacy" && have_legacy=1
	ipv6_mode=$(setting_ipv6_mode)
	: > "$dest"
	echo '# generated by xboxaccel' >> "$dest"
	while IFS="$(printf '\t')" read -r host pool edge extra; do
		case "$host" in
			''|'#'*) continue ;;
		esac
		case "$edge" in
			cn|'')
				case "$pool" in
					primary) ip=$primary ;;
					legacy) ip=$legacy ;;
					*) continue ;;
				esac
				public_ipv4 "$ip" || continue
				;;
			global|hop|alias)
				# Domestic nodes reject Host: *.xboxlive.com and have no vhost for
				# xvcf*.xboxlive.cn. These names get a per-host fake alias; nft
				# sends 80 to the 302 listener and 443 to the real origin.
				[ "$pin" = 1 ] || continue
				case "$pool" in
					primary) [ "$have_primary" = 1 ] || continue ;;
					legacy) [ "$have_legacy" = 1 ] || continue ;;
					*) continue ;;
				esac
				map_ip=$(redirect_map_alias "$host")
				[ -n "$map_ip" ] || continue
				ip=$map_ip
				redirect=1
				;;
			*) continue ;;
		esac
		[ "$ipv6_mode" = block ] && printf 'local=/%s/\n' "$host" >> "$dest"
		printf 'address=/%s/%s\n' "$host" "$ip" >> "$dest"
	done < "$DOMAINS"
	[ "$redirect" = 1 ] && printf '%s\n' "$REDIR_MARK" >> "$dest"
	# Xbox asks assets-srvs for a spare CDN and then connects with Host: assets1.xboxlive.com.
	# Point that SRV at the name we already redirect.
	if [ "$pin" = 1 ] && [ "$have_primary" = 1 ]; then
		for srv in \
			assets-srvs.xboxlive.com \
			assets-srvs-net.trafficmanager.net \
			assets-srvs-apac.delivery.microsoft.com \
			assets-srvs-na.delivery.microsoft.com
		do
			[ "$ipv6_mode" = block ] && printf 'local=/%s/\n' "$srv" >> "$dest"
			printf 'srv-host=%s,assets1.xboxlive.com,80,0,0\n' "$srv" >> "$dest"
		done
	fi
}

publish() {
	local primary="$1" legacy="$2" dir dest tmp
	dir=$(confdir)
	mkdir -p "$dir" || return 1
	dest="$dir/$CONF_NAME"
	rm -f "$dir/xboxaccel.conf.bak" "$dir/xboxaccel.conf.mark" "$dir/xboxaccel.conf.retract"
	tmp=$(mktemp) || return 1
	if [ "$(setting_pin)" = 1 ] && { public_ipv4 "$primary" || public_ipv4 "$legacy"; }; then
		if ! build_redirect_map "$primary" "$legacy" 1; then
			rm -f "$REDIR_MAP"
			log "跳转映射没有建立，.com 保持原来的解析"
		fi
	fi
	render_dns "$primary" "$legacy" "$(setting_pin)" "$tmp"
	if redirect_in "$tmp"; then
		if ! setup_redirect; then
			log "国际域名跳转没有启动，.com 保持原来的解析"
			teardown_redirect
			render_dns "$primary" "$legacy" 0 "$tmp"
		fi
	fi
	if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
		rm -f "$tmp"
		finish_redirect "$dest"
		return 0
	fi
	# Backups must stay outside conf-dir. dnsmasq reads every file there.
	if [ -f "$dest" ]; then
		cp -f "$dest" /tmp/xboxaccel.conf.bak || { rm -f "$tmp"; return 1; }
		rm -f /tmp/xboxaccel.mark
	else
		: > /tmp/xboxaccel.conf.bak
		echo absent > /tmp/xboxaccel.mark
	fi
	mv "$tmp" "$dest" || return 1
	chmod 644 "$dest"
	if /etc/init.d/dnsmasq restart >/tmp/xboxaccel.dns.log 2>&1 && verify_published "$dest"; then
		rm -f /tmp/xboxaccel.conf.bak /tmp/xboxaccel.mark
		finish_redirect "$dest"
		return 0
	fi
	if [ -f /tmp/xboxaccel.mark ]; then
		rm -f "$dest" /tmp/xboxaccel.mark /tmp/xboxaccel.conf.bak
	else
		mv -f /tmp/xboxaccel.conf.bak "$dest"
	fi
	/etc/init.d/dnsmasq restart >/tmp/xboxaccel.dns.log 2>&1 || true
	if [ -f "$dest" ] && redirect_in "$dest"; then
		setup_redirect || true
	else
		teardown_redirect
	fi
	log "dnsmasq 没有接受新记录，已退回上一份"
	return 1
}

retract() {
	local dir dest
	dir=$(confdir)
	dest="$dir/$CONF_NAME"
	if [ ! -f "$dest" ]; then
		teardown_redirect
		return 0
	fi
	mv "$dest" /tmp/xboxaccel.conf.retract || return 1
	if /etc/init.d/dnsmasq restart >/tmp/xboxaccel.dns.log 2>&1 && dns_up; then
		rm -f /tmp/xboxaccel.conf.retract
		teardown_redirect
		return 0
	fi
	mv /tmp/xboxaccel.conf.retract "$dest"
	/etc/init.d/dnsmasq restart >/tmp/xboxaccel.dns.log 2>&1 || true
	log "撤回后 dnsmasq 没有恢复，已放回上一份"
	return 1
}

list_candidates() {
	uci -q show xboxaccel 2>/dev/null | awk -F= '
		/^xboxaccel\.[^.]+=candidate$/ {
			if (sec != "") print ip "\t" en "\t" name "\t" pool
			split($1, a, ".")
			sec = a[2]
			ip = ""
			en = "1"
			name = ""
			pool = "primary"
			next
		}
		{
			split($1, a, ".")
			if (a[2] != sec || a[3] == "") next
			val = $2
			gsub(/^'\''|'\''$/, "", val)
			if (a[3] == "ip") ip = val
			else if (a[3] == "enabled") en = val
			else if (a[3] == "name") name = val
			else if (a[3] == "pool") pool = val
		}
		END { if (sec != "") print ip "\t" en "\t" name "\t" pool }
	'
}

catalog_has() {
	awk -F '\t' -v ip="$1" '$1 == ip { found = 1 } END { exit !found }' "$CATALOG"
}

build_catalog() {
	local skip ip loc host group en name pool list
	list=$(nodes_file)
	skip=$(mktemp) || return 1
	: > "$CATALOG"
	list_candidates | while IFS="$(printf '\t')" read -r ip en name pool; do
		[ "$en" = "0" ] && printf '%s\n' "$ip"
	done > "$skip"
	if [ -f "$list" ]; then
		while IFS="$(printf '\t')" read -r ip loc host group; do
			case "$ip" in
				''|'#'*) continue ;;
			esac
			public_ipv4 "$ip" || continue
			en=1
			grep -qxF -- "$ip" "$skip" && en=0
			printf '%s\t%s\t%s\t%s\t%s\n' "$ip" "$loc" "$host" "$group" "$en" >> "$CATALOG"
		done < "$list"
	fi
	list_candidates | while IFS="$(printf '\t')" read -r ip en name pool; do
		[ "$en" = "0" ] && continue
		public_ipv4 "$ip" || continue
		catalog_has "$ip" && continue
		case "$pool" in
			legacy) group=manual-legacy ;;
			*) group=manual-primary ;;
		esac
		printf '%s\t%s\t%s\t%s\t1\n' "$ip" "${name:-手动}" "$(probe_host "$pool")" "$group" >> "$CATALOG"
	done
	rm -f "$skip"
}

collect_parts() {
	local f
	: > "$RESULTS"
	[ -d "$PARTS" ] || return 0
	for f in "$PARTS"/*; do
		[ -f "$f" ] || continue
		cat "$f" >> "$RESULTS"
	done
}

probe_one() {
	local ip="$1" host="$2" path="$3" loc="$4" group="$5" limit="$6" maxtime="$7" scheme="${8:-cn}"
	local line rc http bps conn bytes bps_i ms ok scheme_host target_host redir total
	mkdir -p "$PARTS"
	set -- -4 -sS -o /dev/null --http1.1 --noproxy '*' --max-filesize "$limit" \
		--range "0-$((limit - 1))" --connect-timeout 3 --max-time "$maxtime" \
		-w '%{http_code} %{speed_download} %{time_connect} %{size_download} %{time_redirect} %{time_total}'
	if [ "$scheme" = com ]; then
		scheme_host=$(probe_com_host "$host")
		target_host=$(probe_cn_host "$host")
		set -- "$@" -L --max-redirs 3 \
			--resolve "${scheme_host}:${REDIR_PORT}:127.0.0.1" \
			--resolve "${target_host}:80:${ip}" \
			"http://${scheme_host}:${REDIR_PORT}${path}"
	else
		set -- "$@" --resolve "${host}:80:${ip}" "http://${host}${path}"
	fi
	curl "$@" > "$PARTS/$ip.curlout" 2>/dev/null &
	echo $! > "$PARTS/$ip.curl"
	wait $!
	rc=$?
	line=$(cat "$PARTS/$ip.curlout" 2>/dev/null)
	rm -f "$PARTS/$ip.curl" "$PARTS/$ip.curlout"
	set -- $line
	http=${1:-000}
	bps=${2:-0}
	conn=${3:-0}
	bytes=${4:-0}
	redir=${5:-0}
	total=${6:-0}
	case "$redir" in ''|*[!0-9.]*) redir=0 ;; esac
	case "$total" in ''|*[!0-9.]*) total=0 ;; esac
	if [ "$rc" -ne 0 ] && [ "$rc" -ne 28 ]; then
		http=000
		bps=0
		bytes=0
	fi
	http=$(awk -v s="$http" 'BEGIN { printf "%d", s + 0 }')
	if [ "$scheme" = com ] && awk -v r="$redir" -v t="$total" 'BEGIN { exit !(r > 0 && t > r) }'; then
		bps_i=$(awk -v b="$bytes" -v t="$total" -v r="$redir" 'BEGIN { printf "%d", b / (t - r) }')
	else
		bps_i=$(awk -v s="$bps" 'BEGIN { printf "%d", s + 0 }')
	fi
	ms=$(awk -v s="$conn" 'BEGIN { printf "%d", (s + 0) * 1000 }')
	bytes=$(awk -v s="$bytes" 'BEGIN { printf "%d", s + 0 }')
	ok=0
	case "$http" in
		200|206) [ "$bytes" -ge 1048576 ] && ok=1 ;;
	esac
	mkdir -p "$PARTS"
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$ip" "$http" "$bps_i" "$ms" "$ok" "$bytes" "$group" "$host" "$loc" > "$PARTS/$ip.new"
	mv "$PARTS/$ip.new" "$PARTS/$ip"
}

stop_probes() {
	local f pid
	[ -d "$PARTS" ] || return 0
	for f in "$PARTS"/*.curl; do
		[ -f "$f" ] || continue
		pid=$(cat "$f" 2>/dev/null)
		kill "$pid" 2>/dev/null
	done
	[ -n "$BATCH" ] && kill $BATCH 2>/dev/null
	[ -n "$BATCH" ] && wait $BATCH 2>/dev/null
	BATCH=
}

wait_batch() {
	local pid alive
	[ -n "$BATCH" ] || return 0
	while :; do
		if stale; then
			stop_probes
			return 1
		fi
		alive=0
		for pid in $BATCH; do
			if kill -0 "$pid" 2>/dev/null; then
				alive=1
			fi
		done
		[ "$alive" = 1 ] || break
		sleep 1
	done
	wait $BATCH 2>/dev/null
	BATCH=
	if stale; then
		stop_probes
		return 1
	fi
	return 0
}

run_probes() {
	local ip loc host group en n=0 limit maxtime path path_legacy probe_path scheme
	scheme=${SCHEME:-cn}
	path=$(sample_path)
	path_legacy=$(sample_path_legacy)
	if [ "$scheme" = com ]; then
		if ! ensure_http; then
			log "跳转服务没有起来，.com 测速无法开始"
			SCHEME_FAILED=1
			return 1
		fi
	fi
	if [ "$SWEEP" = routine ]; then
		limit=$((8 * 1048576))
		maxtime=12
		SAMPLE_MIB=8
		CAP=10
	else
		limit=$(setting_mib)
		SAMPLE_MIB=$limit
		limit=$((limit * 1048576))
		maxtime=18
		CAP=24
	fi
	if [ "$scheme" = com ] && [ "$limit" -lt 16777216 ]; then
		limit=$((16 * 1048576))
		SAMPLE_MIB=16
		maxtime=18
	fi
	rm -rf "$PARTS"
	mkdir -p "$PARTS"
	: > "$RESULTS"
	while IFS="$(printf '\t')" read -r ip loc host group en; do
		if stale; then
			return 1
		fi
		[ "$en" = "1" ] || continue
		public_ipv4 "$ip" || continue
		valid_host "$host" || continue
		case "$group" in
			cn2|manual-legacy) probe_path=$path_legacy ;;
			*) probe_path=$path ;;
		esac
		probe_one "$ip" "$host" "$probe_path" "$loc" "$group" "$limit" "$maxtime" "$scheme" &
		BATCH="$BATCH $!"
		n=$((n + 1))
		if [ "$n" -ge 6 ]; then
			wait_batch || return 1
			n=0
			collect_parts
			write_running
		fi
	done < "$ROSTER_OUT"
	wait_batch || return 1
	collect_parts
}

keep_on_miss() {
	local pool="$1"
	[ -n "$2" ] || return 1
	[ -s "$RESULTS" ] || return 1
	awk -F '\t' -v pool="$pool" '
		function want(group) {
			if (pool == "primary") return group == "cn1" || group == "manual-primary"
			return group == "cn2" || group == "manual-legacy"
		}
		want($7) {
			seen++
			if ($2 != 404) other = 1
		}
		END { exit !(seen && !other) }
	' "$RESULTS"
}

summary_reason() {
	local primary="$1" legacy="$2"
	case "$primary" in switched) printf '%s\n' switched; return ;; esac
	case "$legacy" in switched) printf '%s\n' switched; return ;; esac
	case "$primary" in current-dead) printf '%s\n' current-dead; return ;; esac
	case "$legacy" in current-dead) printf '%s\n' current-dead; return ;; esac
	case "$primary" in selected) printf '%s\n' selected; return ;; esac
	case "$legacy" in selected) printf '%s\n' selected; return ;; esac
	case "$primary:$legacy" in
		no-healthy:no-healthy|no-candidate:no-candidate|no-healthy:no-candidate|no-candidate:no-healthy)
			printf '%s\n' "$primary"
			return
			;;
	esac
	printf '%s\n' kept
}

set_if_changed() {
	local key="$1" value="$2" cur
	cur=$(uci_get "$key")
	[ "$cur" = "$value" ] && return 0
	uci set "xboxaccel.main.$key=$value"
	DIRTY=1
}

write_status() {
	local running="$1" tmp ip http bps ms ok bytes group host loc finished=0
	[ -f "$RESULTS" ] && finished=$(awk 'END { print NR + 0 }' "$RESULTS")
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_int running "$running"
	if enabled; then
		json_add_int enabled 1
	else
		json_add_int enabled 0
	fi
	json_add_int time "$(date +%s)"
	json_add_string mode "$(setting_mode)"
	json_add_string reason "${OVERALL:-idle}"
	json_add_int margin "$(setting_margin)"
	json_add_string carrier "${CARRIER:-$(setting_carrier)}"
	json_add_string sweep "${SWEEP:-}"
	json_add_string probe_scheme "${SCHEME:-$(setting_scheme)}"
	json_add_string redirect_net "${REDIRECT_NET_ACTIVE:-$(setting_redirect_net)}"
	json_add_int origin_count "${ORIGIN_COUNT:-0}"
	json_add_int origin_missing "${ORIGIN_MISSING:-0}"
	json_add_string ipv6_mode "$(setting_ipv6_mode)"
	json_add_string probe_ip "${PROBE_IP:-}"
	json_add_int probe_bytes "${PROBE_BYTES:-0}"
	json_add_int probe_bps "${PROBE_BPS:-0}"
	json_add_int probe_limit "${PROBE_LIMIT:-0}"
	json_add_int pin_global "$(setting_pin)"
	json_add_string primary_ip "${PRIMARY:-}"
	json_add_string legacy_ip "${LEGACY:-}"
	json_add_string primary_reason "${PRIMARY_REASON:-}"
	json_add_string legacy_reason "${LEGACY_REASON:-}"
	json_add_string active "${PRIMARY:-}"
	json_add_int planned "${PLANNED:-0}"
	json_add_int finished "$finished"
	json_add_int sample_mib "${SAMPLE_MIB:-$(setting_mib)}"
	json_add_int cap "${CAP:-0}"
	json_add_int com_n "${COM_N:-0}"
	json_add_string com_avg "${COM_AVG:-}"
	json_add_string com_min "${COM_MIN:-}"
	json_add_string com_max "${COM_MAX:-}"
	json_add_int com_warn "${COM_WARN:-0}"
	json_add_array results
	if [ -f "$RESULTS" ]; then
		while IFS="$(printf '\t')" read -r ip http bps ms ok bytes group host loc; do
			[ -n "$ip" ] || continue
			json_add_object ""
			json_add_string ip "$ip"
			json_add_int http "${http:-0}"
			json_add_int bps "${bps:-0}"
			json_add_int conn_ms "${ms:-0}"
			json_add_int ok "${ok:-0}"
			json_add_int bytes "${bytes:-0}"
			json_add_string group "${group:-manual-primary}"
			json_add_string host "${host:-}"
			json_add_string loc "${loc:-}"
			json_close_object
		done < "$RESULTS"
	fi
	json_close_array
	tmp=$(mktemp) || return 1
	json_dump > "$tmp"
	mv "$tmp" "$STATUS"
	chmod 644 "$STATUS"
}

note_stopped() {
	collect_parts
	rm -f "$ROSTER_OUT"
	if [ "$(setting_mode)" = static ]; then
		load_static_view
	else
		PRIMARY=$(setting_active_primary)
		LEGACY=$(setting_active_legacy)
		PRIMARY_REASON=kept
		LEGACY_REASON=kept
		OVERALL=kept
	fi
	if [ -f "$STOP" ]; then
		rm -f "$STOP"
		OVERALL=stopped
		date +%s > "$LAST"
		log "测速已停止"
	else
		log "这轮测速被新操作打断"
	fi
	write_status 0
}

write_running() {
	OVERALL=running
	PRIMARY_REASON=running
	LEGACY_REASON=running
	if [ "$(setting_mode)" = static ]; then
		PRIMARY=$(setting_primary)
		LEGACY=$(setting_legacy)
	else
		PRIMARY=$(setting_active_primary)
		LEGACY=$(setting_active_legacy)
	fi
	write_status 1
}

take_decision() {
	local pool="$1" current="$2" margin="$3" decision ip reason
	decision=$("$POLICY" decide "$pool" "$current" "$margin" < "$RESULTS")
	ip=$(printf '%s\n' "$decision" | awk -F '\t' 'NR==1 { print $1 }')
	reason=$(printf '%s\n' "$decision" | awk -F '\t' 'NR==1 { print $2 }')
	if [ "$reason" = no-healthy ] && keep_on_miss "$pool" "$current"; then
		ip=$current
		reason=sample-miss
	fi
	case "$reason" in
		no-healthy|no-candidate) ip= ;;
	esac
	public_ipv4 "$ip" || ip=
	printf '%s\t%s\n' "$ip" "$reason"
}

compare_com() {
	[ "$SCHEME" = com ] || return 0
	[ "$PREV_SCHEME" = cn ] || return 0
	[ -s "$HISTORY" ] || return 0
	[ -s "$RESULTS" ] || return 0
	awk -F '\t' '
		NR == FNR {
			if ($5 == 1 && ($3 + 0) > 0) cn[$1] = $3 + 0
			next
		}
		$5 == 1 && ($1 in cn) && cn[$1] > 0 {
			n++
			r = ($3 + 0) / cn[$1]
			sum += r
			if (min == 0 || r < min) min = r
			if (max == 0 || r > max) max = r
		}
		END {
			if (n) printf "%d %.3f %.3f %.3f\n", n, sum / n, min, max
		}
	' "$HISTORY" "$RESULTS"
}

finish_test() {
	local mode margin cur_p cur_l picked reason_p reason_l new_p new_l com
	mode=$(setting_mode)
	margin=$(setting_margin)
	if [ "$mode" = static ]; then
		PRIMARY=$(setting_primary)
		LEGACY=$(setting_legacy)
		PRIMARY_REASON=static
		LEGACY_REASON=static
		OVERALL=static
		write_status 0
		date +%s > "$LAST"
		log "测速结束，静态地址未改 主=${PRIMARY:-无} 旧=${LEGACY:-无}"
		return 0
	fi
	cur_p=$(setting_active_primary)
	cur_l=$(setting_active_legacy)
	picked=$(take_decision primary "$cur_p" "$margin")
	new_p=$(printf '%s\n' "$picked" | awk -F '\t' 'NR==1 { print $1 }')
	reason_p=$(printf '%s\n' "$picked" | awk -F '\t' 'NR==1 { print $2 }')
	picked=$(take_decision legacy "$cur_l" "$margin")
	new_l=$(printf '%s\n' "$picked" | awk -F '\t' 'NR==1 { print $1 }')
	reason_l=$(printf '%s\n' "$picked" | awk -F '\t' 'NR==1 { print $2 }')
	if stale; then
		note_stopped
		return 0
	fi
	if enabled; then
		if ! publish "$new_p" "$new_l"; then
			PRIMARY=$cur_p
			LEGACY=$cur_l
			PRIMARY_REASON=dns-failed
			LEGACY_REASON=dns-failed
			OVERALL=dns-failed
			write_status 0
			return 1
		fi
	fi
	if stale; then
		PRIMARY=$new_p
		LEGACY=$new_l
		PRIMARY_REASON=$reason_p
		LEGACY_REASON=$reason_l
		OVERALL=$(summary_reason "$reason_p" "$reason_l")
		if [ -f "$STOP" ]; then
			rm -f "$STOP"
			OVERALL=stopped
			log "测速已停止"
		else
			log "这轮测速被新操作打断"
		fi
		write_status 0
		return 0
	fi
	DIRTY=0
	set_if_changed active_primary "$new_p"
	set_if_changed active_legacy "$new_l"
	set_if_changed active_ip "$new_p"
	[ "$DIRTY" = 1 ] && uci commit xboxaccel
	PRIMARY=$new_p
	LEGACY=$new_l
	PRIMARY_REASON=$reason_p
	LEGACY_REASON=$reason_l
	OVERALL=$(summary_reason "$reason_p" "$reason_l")
	COM_N=0
	COM_AVG=
	COM_MIN=
	COM_MAX=
	COM_WARN=0
	if [ "$SCHEME" = com ]; then
		com=$(compare_com)
		if [ -n "$com" ]; then
			set -- $com
			COM_N=$1
			COM_AVG=$2
			COM_MIN=$3
			COM_MAX=$4
			if awk -v m="$COM_AVG" 'BEGIN { exit !(m > 0 && m < 0.8) }'; then
				COM_WARN=1
			fi
			log ".com/.cn 对照：${COM_N} 个节点，平均 $(awk -v x="$COM_AVG" 'BEGIN { printf "%.0f%%", x * 100 }')，最差 $(awk -v x="$COM_MIN" 'BEGIN { printf "%.0f%%", x * 100 }')"
			if [ "$COM_WARN" = 1 ]; then
				log ".com 测速平均比 .cn 慢超过 20%（平均 $(awk -v x="$COM_AVG" 'BEGIN { printf "%.0f%%", x * 100 }')）"
			fi
		fi
	fi
	write_status 0
	date +%s > "$LAST"
	log "测速结束 $OVERALL 主=${new_p:-无}($reason_p) 旧=${new_l:-无}($reason_l)"
}

cmd_test() {
	local sweep="$1" carrier="$2" scheme="$3"
	case "$sweep" in
		routine|thorough) ;;
		*) sweep=thorough ;;
	esac
	case "$carrier" in
		any|telecom|unicom|mobile) ;;
		*) carrier=$(setting_carrier) ;;
	esac
	case "$scheme" in
		com|cn) ;;
		*) scheme=$(setting_scheme) ;;
	esac
	SCHEME=$scheme
	SCHEME_FAILED=0
	exec 9>"$LOCK"
	flock -n 9 || {
		echo busy
		log "已有一轮测速在进行"
		exit 0
	}
	PREV_SCHEME=$(cat "$SCHEME_FILE" 2>/dev/null || true)
	echo "$SCHEME" > "$SCHEME_FILE"
	rm -f "$STOP"
	gen0=$(cat "$GEN" 2>/dev/null || echo 0)
	PROBE_IP=
	SWEEP=$sweep
	CARRIER=$carrier
	migrate_uci
	if [ -s "$RESULTS" ]; then
		cp -f "$RESULTS" "$HISTORY"
	fi
	[ -f "$HISTORY" ] || : > "$HISTORY"
	build_catalog
	ROSTER_OUT=$(mktemp) || return 1
	"$ROSTER" "$SWEEP" "$CARRIER" "$(setting_active_primary)" "$(setting_active_legacy)" "$HISTORY" < "$CATALOG" > "$ROSTER_OUT"
	PLANNED=$(awk 'END { print NR + 0 }' "$ROSTER_OUT")
	if [ "$SWEEP" = routine ]; then
		SAMPLE_MIB=8
		CAP=10
	else
		SAMPLE_MIB=$(setting_mib)
		CAP=24
	fi
	write_running
	if [ "$SWEEP" = routine ]; then
		if [ "$SCHEME" = com ]; then
			log "开始快速测速，计划 ${PLANNED} 个地址（.com 302）"
		else
			log "开始快速测速，计划 ${PLANNED} 个地址（.cn 直连）"
		fi
	else
		if [ "$SCHEME" = com ]; then
			log "开始完整测速，计划 ${PLANNED} 个地址（.com 302）"
		else
			log "开始完整测速，计划 ${PLANNED} 个地址（.cn 直连）"
		fi
	fi
	if ! run_probes || stale; then
		if [ "$SCHEME_FAILED" = 1 ]; then
			PRIMARY=$(setting_active_primary)
			LEGACY=$(setting_active_legacy)
			PRIMARY_REASON=redirect-failed
			LEGACY_REASON=redirect-failed
			OVERALL=redirect-failed
			write_status 0
			log ".com 测速失败：本机 302 跳转服务没有起来"
			return 0
		fi
		note_stopped
		return 0
	fi
	finish_test
	rm -f "$ROSTER_OUT"
}

cmd_tick() {
	local interval now last elapsed need
	enabled || exit 0
	[ "$(setting_mode)" = dynamic ] || exit 0
	interval=$(setting_interval)
	now=$(date +%s)
	last=0
	[ -f "$LAST" ] && last=$(cat "$LAST" 2>/dev/null || echo 0)
	case "$last" in ''|*[!0-9]*) last=0 ;; esac
	elapsed=$((now - last))
	need=$((interval * 60))
	[ "$elapsed" -lt "$need" ] && exit 0
	cmd_test routine "$(setting_carrier)"
}

load_static_view() {
	PRIMARY=$(setting_primary)
	LEGACY=$(setting_legacy)
	PRIMARY_REASON=static
	LEGACY_REASON=static
	OVERALL=static
	if ! public_ipv4 "$PRIMARY" && ! public_ipv4 "$LEGACY"; then
		OVERALL=missing-ip
	fi
}

cmd_apply() {
	local mode
	bump_gen
	exec 9>"$LOCK"
	flock 9
	migrate_uci
	mode=$(setting_mode)
	SWEEP=
	if ! enabled; then
		retract || true
		remove_cron
		PRIMARY=$(setting_primary)
		LEGACY=$(setting_legacy)
		PRIMARY_REASON=disabled
		LEGACY_REASON=disabled
		OVERALL=disabled
		write_status 0
		log "服务已停用，记录已撤回"
		return 0
	fi
	if [ "$mode" = static ]; then
		install_cron
		load_static_view
		if ! publish "$PRIMARY" "$LEGACY"; then
			PRIMARY_REASON=dns-failed
			LEGACY_REASON=dns-failed
			OVERALL=dns-failed
			write_status 0
			return 1
		fi
		write_status 0
		log "静态记录已生效 主=${PRIMARY:-无} 旧=${LEGACY:-无}"
		return 0
	fi
	install_cron
	PRIMARY=$(setting_active_primary)
	LEGACY=$(setting_active_legacy)
	if public_ipv4 "$PRIMARY" || public_ipv4 "$LEGACY"; then
		PRIMARY_REASON=kept
		LEGACY_REASON=kept
		OVERALL=kept
		if ! publish "$PRIMARY" "$LEGACY"; then
			PRIMARY_REASON=dns-failed
			LEGACY_REASON=dns-failed
			OVERALL=dns-failed
			write_status 0
			return 1
		fi
		write_status 0
		log "动态记录已生效 主=${PRIMARY:-无} 旧=${LEGACY:-无}"
		return 0
	fi
	retract || true
	PRIMARY_REASON=running
	LEGACY_REASON=running
	OVERALL=running
	PLANNED=0
	write_status 1
	log "动态模式还没有地址，已开始测速"
	flock -u 9
	/usr/sbin/xboxaccel test-bg routine "$(setting_carrier)"
}

cmd_use() {
	local pool="$1" ip="$2"
	case "$pool" in
		primary|legacy) ;;
		*)
			echo "线路必须是 primary 或 legacy" >&2
			exit 1
			;;
	esac
	public_ipv4 "$ip" || {
		echo "这个地址不是公网 IPv4" >&2
		exit 1
	}
	bump_gen
	exec 9>"$LOCK"
	flock 9
	migrate_uci
	uci set xboxaccel.main.mode='static'
	uci set xboxaccel.main.enabled='1'
	if [ "$pool" = primary ]; then
		uci set "xboxaccel.main.primary_ip=$ip"
		uci set "xboxaccel.main.active_primary=$ip"
		uci set "xboxaccel.main.static_ip=$ip"
		uci set "xboxaccel.main.active_ip=$ip"
	else
		uci set "xboxaccel.main.legacy_ip=$ip"
		uci set "xboxaccel.main.active_legacy=$ip"
	fi
	uci commit xboxaccel
	install_cron
	load_static_view
	if ! publish "$PRIMARY" "$LEGACY"; then
		PRIMARY_REASON=dns-failed
		LEGACY_REASON=dns-failed
		OVERALL=dns-failed
		write_status 0
		exit 1
	fi
	write_status 0
	if [ "$pool" = legacy ]; then
		log "已改用静态旧下载 $ip"
	else
		log "已改用静态主下载 $ip"
	fi
}

publish_probe() {
	local running="$1"
	restore_view
	SWEEP=once
	SAMPLE_MIB=8
	PLANNED=0
	CAP=1
	if [ "$running" = 1 ]; then
		OVERALL=running
	fi
	write_status "$running"
}

probe_watch() {
	local ip="$1" host="$2" path="$3" loc="$4" group="$5" limit="$6" maxtime="$7" scheme="${8:-cn}"
	local cpid rc line http bps conn bytes bps_i ms ok cur start_cs now_cs elapsed scheme_host target_host redir total
	mkdir -p "$PARTS"
	rm -f "$PARTS/$ip.body" "$PARTS/$ip.curl" "$PARTS/$ip.curlout"
	: > "$PARTS/$ip.body"
	set -- -4 -sS -o "$PARTS/$ip.body" --http1.1 --noproxy '*' --max-filesize "$limit" \
		--range "0-$((limit - 1))" --connect-timeout 3 --max-time "$maxtime" \
		-w '%{http_code} %{speed_download} %{time_connect} %{size_download} %{time_redirect} %{time_total}'
	if [ "$scheme" = com ]; then
		scheme_host=$(probe_com_host "$host")
		target_host=$(probe_cn_host "$host")
		set -- "$@" -L --max-redirs 3 \
			--resolve "${scheme_host}:${REDIR_PORT}:127.0.0.1" \
			--resolve "${target_host}:80:${ip}" \
			"http://${scheme_host}:${REDIR_PORT}${path}"
	else
		set -- "$@" --resolve "${host}:80:${ip}" "http://${host}${path}"
	fi
	curl "$@" > "$PARTS/$ip.curlout" 2>/dev/null &
	cpid=$!
	echo "$cpid" > "$PARTS/$ip.curl"
	start_cs=$(awk '{ printf "%d", $1 * 100 }' /proc/uptime)
	while kill -0 "$cpid" 2>/dev/null; do
		if stale; then
			kill "$cpid" 2>/dev/null
			break
		fi
		cur=0
		if [ -f "$PARTS/$ip.body" ]; then
			cur=$(wc -c < "$PARTS/$ip.body" | awk '{ print $1 + 0 }')
		fi
		now_cs=$(awk '{ printf "%d", $1 * 100 }' /proc/uptime)
		elapsed=$((now_cs - start_cs))
		PROBE_BYTES=$cur
		PROBE_LIMIT=$limit
		if [ "$elapsed" -gt 0 ] && [ "$cur" -gt 0 ]; then
			PROBE_BPS=$((cur * 100 / elapsed))
		fi
		publish_probe 1
		python3 -c 'import time; time.sleep(0.1)' 2>/dev/null || sleep 1
	done
	wait "$cpid"
	rc=$?
	line=$(cat "$PARTS/$ip.curlout" 2>/dev/null)
	rm -f "$PARTS/$ip.curl" "$PARTS/$ip.curlout" "$PARTS/$ip.body"
	set -- $line
	http=${1:-000}
	bps=${2:-0}
	conn=${3:-0}
	bytes=${4:-0}
	redir=${5:-0}
	total=${6:-0}
	case "$redir" in ''|*[!0-9.]*) redir=0 ;; esac
	case "$total" in ''|*[!0-9.]*) total=0 ;; esac
	if [ "$rc" -ne 0 ] && [ "$rc" -ne 28 ]; then
		http=000
		bps=0
		bytes=0
	fi
	http=$(awk -v s="$http" 'BEGIN { printf "%d", s + 0 }')
	if [ "$scheme" = com ] && awk -v r="$redir" -v t="$total" 'BEGIN { exit !(r > 0 && t > r) }'; then
		bps_i=$(awk -v b="$bytes" -v t="$total" -v r="$redir" 'BEGIN { printf "%d", b / (t - r) }')
	else
		bps_i=$(awk -v s="$bps" 'BEGIN { printf "%d", s + 0 }')
	fi
	ms=$(awk -v s="$conn" 'BEGIN { printf "%d", (s + 0) * 1000 }')
	bytes=$(awk -v s="$bytes" 'BEGIN { printf "%d", s + 0 }')
	ok=0
	case "$http" in
		200|206) [ "$bytes" -ge 1048576 ] && ok=1 ;;
	esac
	PROBE_BYTES=$bytes
	PROBE_BPS=$bps_i
	PROBE_LIMIT=$limit
	printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$ip" "$http" "$bps_i" "$ms" "$ok" "$bytes" "$group" "$host" "$loc" > "$PARTS/$ip"
}

merge_one() {
	local file="$1" ip
	[ -f "$file" ] || return 0
	ip=$(awk -F '\t' 'NR==1 { print $1; exit }' "$file")
	[ -n "$ip" ] || return 0
	[ -f "$RESULTS" ] || : > "$RESULTS"
	awk -F '\t' -v ip="$ip" '$1 != ip && $1 != ""' "$RESULTS" > "$RESULTS.one"
	cat "$file" >> "$RESULTS.one"
	mv "$RESULTS.one" "$RESULTS"
}

restore_view() {
	if [ "$(setting_mode)" = static ]; then
		load_static_view
	else
		PRIMARY=$(setting_active_primary)
		LEGACY=$(setting_active_legacy)
		PRIMARY_REASON=kept
		LEGACY_REASON=kept
		OVERALL=kept
	fi
}

cmd_probe() {
	local ip="$1" scheme="$2" loc host group limit pool path maxtime list
	public_ipv4 "$ip" || {
		echo "这个地址不是公网 IPv4" >&2
		exit 1
	}
	case "$scheme" in
		com|cn) ;;
		*) scheme=$(setting_scheme) ;;
	esac
	SCHEME=$scheme
	exec 9>"$LOCK"
	flock -n 9 || {
		echo busy
		exit 0
	}
	rm -f "$STOP"
	gen0=$(cat "$GEN" 2>/dev/null || echo 0)
	if [ "$SCHEME" = com ] && ! ensure_http; then
		PRIMARY=$(setting_active_primary)
		LEGACY=$(setting_active_legacy)
		PRIMARY_REASON=redirect-failed
		LEGACY_REASON=redirect-failed
		OVERALL=redirect-failed
		write_status 0
		log "单点 .com 测速失败：本机 302 跳转服务没有起来"
		return 0
	fi
	restore_view
	SWEEP=once
	PROBE_IP=$ip
	PROBE_BYTES=0
	PROBE_BPS=0
	PLANNED=0
	CAP=1
	limit=$((8 * 1048576))
	maxtime=12
	if [ "$SCHEME" = com ]; then
		limit=$((16 * 1048576))
		maxtime=18
	fi
	SAMPLE_MIB=$((limit / 1048576))
	CARRIER=$(setting_carrier)
	PROBE_LIMIT=$limit
	OVERALL=running
	write_status 1
	if [ "$SCHEME" = com ]; then
		log "开始单点测速 $ip（.com 302）"
	else
		log "开始单点测速 $ip（.cn 直连）"
	fi
	list=$(nodes_file)
	loc=$(awk -F '\t' -v ip="$ip" '$1 == ip { print $2; exit }' "$list")
	host=$(awk -F '\t' -v ip="$ip" '$1 == ip { print $3; exit }' "$list")
	group=$(awk -F '\t' -v ip="$ip" '$1 == ip { print $4; exit }' "$list")
	pool=primary
	case "$group" in
		cn2|manual-legacy) pool=legacy ;;
	esac
	if [ -z "$host" ]; then
		set -- $(list_candidates | awk -F '\t' -v ip="$ip" '$1 == ip && $2 != "0" { print $4, $3; exit }')
		case "$1" in
			legacy) group=manual-legacy; pool=legacy ;;
			*) group=manual-primary; pool=primary ;;
		esac
		loc=${2:-手动}
		host=$(probe_host "$pool")
	fi
	[ -n "$host" ] || host=$(probe_host "$pool")
	[ -n "$loc" ] || loc=手动
	[ -n "$group" ] || group=manual-primary
	valid_host "$host" || host=$(probe_host "$pool")
	case "$group" in
		cn2|manual-legacy) path=$(sample_path_legacy) ;;
		*) path=$(sample_path) ;;
	esac
	mkdir -p "$PARTS"
	probe_watch "$ip" "$host" "$path" "$loc" "$group" "$limit" "$maxtime" "$SCHEME"
	if stale; then
		restore_view
		SWEEP=once
		PROBE_IP=$ip
		if [ -f "$STOP" ]; then
			rm -f "$STOP"
			OVERALL=stopped
			date +%s > "$LAST"
			log "测速已停止"
		else
			log "这轮测速被新操作打断"
		fi
		write_status 0
		return 0
	fi
	merge_one "$PARTS/$ip"
	restore_view
	SWEEP=once
	PROBE_IP=$ip
	OVERALL=probed
	write_status 0
	log "单点测速结束 $ip"
}

cmd_stop() {
	local f pid
	exec 7>"$LOCK"
	if flock -n 7; then
		flock -u 7
		echo idle
		return 0
	fi
	: > "$STOP"
	bump_gen
	for f in "$PARTS"/*.curl; do
		[ -f "$f" ] || continue
		pid=$(cat "$f" 2>/dev/null)
		kill "$pid" 2>/dev/null
	done
	echo stopped
}

cmd_refresh() {
	local p l old old_alias new_alias changed=0
	exec 9>"$LOCK"
	flock -n 9 || exit 0
	enabled || exit 0
	[ "$(setting_pin)" = 1 ] || exit 0
	p=$(setting_active_primary)
	l=$(setting_active_legacy)
	{ public_ipv4 "$p" || public_ipv4 "$l"; } || exit 0
	old=$(mktemp) || exit 1
	old_alias=$(mktemp) || { rm -f "$old"; exit 1; }
	new_alias=$(mktemp) || { rm -f "$old" "$old_alias"; exit 1; }
	if [ -s "$REDIR_MAP" ]; then
		cp -f "$REDIR_MAP" "$old"
		awk -F '\t' '{ print $1 "\t" $2 }' "$old" > "$old_alias"
	fi
	if ! build_redirect_map "$p" "$l" 1; then
		rm -f "$old" "$old_alias" "$new_alias"
		exit 0
	fi
	awk -F '\t' '{ print $1 "\t" $2 }' "$REDIR_MAP" > "$new_alias"
	cmp -s "$old_alias" "$new_alias" || changed=1
	rm -f "$old" "$old_alias" "$new_alias"
	if [ "$changed" = 1 ]; then
		publish "$p" "$l"
	else
		ensure_nft || {
			log "源站刷新后 nft 重建失败"
			exit 1
		}
	fi
}

cmd_repair() {
	local dir dest
	exec 9>"$LOCK"
	# A speed test holds this lock for a long time. Skip rather than block hotplug.
	flock -n 9 || exit 0
	dir=$(confdir) || exit 0
	dest="$dir/$CONF_NAME"
	[ -f "$dest" ] || exit 0
	redirect_in "$dest" || exit 0
	build_redirect_map "$(setting_active_primary)" "$(setting_active_legacy)" 1 || true
	setup_redirect
}

cmd_clear() {
	bump_gen
	exec 9>"$LOCK"
	flock 9
	retract || true
	remove_cron
	PRIMARY=$(setting_primary)
	LEGACY=$(setting_legacy)
	PRIMARY_REASON=disabled
	LEGACY_REASON=disabled
	OVERALL=disabled
	write_status 0
	log "记录已撤回"
}

cmd_log() {
	local n="${1:-200}" action="$2"
	case "$n" in
		conn)
			if [ "$action" = clear ]; then
				: > "$CONN_LOG"
				return 0
			fi
			[ -s "$CONN_LOG" ] || return 0
			tail -n 200 "$CONN_LOG"
			return 0
			;;
		clear)
			: > "$LOG.seed"
			: > "$LOG"
			printf '%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "日志已清空" >> "$LOG"
			return 0
			;;
	esac
	case "$n" in ''|*[!0-9]*) n=200 ;; esac
	[ "$n" -gt 300 ] && n=300
	[ "$n" -lt 1 ] && n=1
	seed_log
	[ -s "$LOG" ] || return 0
	tail -n "$n" "$LOG"
}

cmd_preview() {
	local primary="$1" legacy="$2"
	[ -n "$primary" ] || primary=$(setting_primary)
	[ -n "$legacy" ] || legacy=$(setting_legacy)
	if [ "$(setting_pin)" = 1 ] && { public_ipv4 "$primary" || public_ipv4 "$legacy"; }; then
		build_redirect_map "$primary" "$legacy" 1 || true
	fi
	render_dns "$primary" "$legacy" "$(setting_pin)" /dev/stdout
}

cmd_nft_preview() {
	local map="${1:-$REDIR_MAP}"
	[ -s "$map" ] || {
		echo "no redirect map" >&2
		exit 1
	}
	REDIR_MAP=$map
	nft_rules
}

expect_redirect() {
	local host="$1" uri="$2" location="$3" out script
	script="$(share_dir)/www/cgi-bin/redirect"
	out=$(HTTP_HOST="$host" REQUEST_URI="$uri" /bin/sh "$script" 2>/dev/null) || return 1
	printf '%s\n' "$out" | tr -d '\r' | grep -q "Location: ${location}"
}

redirect_selftest() {
	local tmp share script old
	share=$(share_dir)
	script="$share/www/cgi-bin/redirect"
	[ -f "$script" ] || {
		echo "redirect script missing" >&2
		return 1
	}
	expect_redirect 'xvcf1.xboxlive.com' '/Z/routing/extraextralarge.txt' \
		'http://assets1.xboxlive.cn/Z/routing/extraextralarge.txt' || return 1
	expect_redirect 'xvcf1.xboxlive.cn' '/Z/routing/extraextralarge.txt' \
		'http://assets1.xboxlive.cn/Z/routing/extraextralarge.txt' || return 1
	expect_redirect 'XVCF2.Xboxlive.Cn:80' '/a?x=1' \
		'http://assets1.xboxlive.cn/a?x=1' || return 1
	expect_redirect 'Assets2.Xboxlive.Com:80' '/a?x=1' \
		'http://assets1.xboxlive.cn/a?x=1' || return 1
	expect_redirect 'dlassets2.xboxlive.com' '/old' \
		'http://dlassets.xboxlive.cn/old' || return 1
	expect_redirect 'assets1.xboxlive.com.edgesuite.net' '/cdn' \
		'http://assets1.xboxlive.cn/cdn' || return 1
	expect_redirect '5.xb.delivery.microsoft.com' '/g' \
		'http://assets1.xboxlive.cn/g' || return 1
	expect_redirect 'fg.microsoft.map.fastly.net' '/f' \
		'http://assets1.xboxlive.cn/f' || return 1
	expect_redirect 'cl-glcb907925.gcdn.co' '/c' \
		'http://assets1.xboxlive.cn/c' || return 1
	out=$(HTTP_HOST='example.com' REQUEST_URI='/' /bin/sh "$script") || return 1
	printf '%s\n' "$out" | grep -q '404' || return 1
	out=$(HTTP_HOST="$(printf 'assets1.xboxlive.com\r\nX: y')" REQUEST_URI="$(printf '/ok\r\nX: 1')" /bin/sh "$script") || return 1
	printf '%s\n' "$out" | grep -q '400' || return 1
	tmp=$(mktemp) || return 1
	map=$(mktemp) || { rm -f "$tmp"; return 1; }
	dom=$(mktemp) || { rm -f "$tmp" "$map"; return 1; }
	map2=$(mktemp) || { rm -f "$tmp" "$map" "$dom"; return 1; }
	origins=$(mktemp) || { rm -f "$tmp" "$map" "$dom" "$map2"; return 1; }
	old=$DOMAINS
	old_map=$REDIR_MAP
	old_origins=$REDIR_ORIGINS
	DOMAINS="$share/domains"
	cat > "$map" <<'EOF'
assets1.xboxlive.com	198.51.100.1	23.1.1.1
assets2.xboxlive.com	198.51.100.2	23.1.1.2
d1.xboxlive.com	198.51.100.3	23.1.1.3
d2.xboxlive.com	198.51.100.4	23.1.1.4
xvcf1.xboxlive.com	198.51.100.5	23.1.1.5
xvcf2.xboxlive.com	198.51.100.6	23.1.1.6
xvcf1.xboxlive.cn	198.51.100.7	-
xvcf2.xboxlive.cn	198.51.100.8	-
dlassets.xboxlive.com	198.51.100.9	23.1.1.9
dlassets2.xboxlive.com	198.51.100.10	23.1.1.10
5.xb.delivery.microsoft.com	198.51.100.11	23.1.1.11
assets1.xboxlive.com.edgesuite.net	198.51.100.12	23.1.1.12
cl-glcb907925.gcdn.co	198.51.100.13	23.1.1.13
fg.microsoft.map.fastly.net	198.51.100.14	23.1.1.14
EOF
	REDIR_MAP=$map
	render_dns 219.152.87.113 '' 1 "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	grep -q '^address=/assets1.xboxlive.cn/219.152.87.113$' "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	grep -q '^address=/assets1.xboxlive.com/198.51.100.1$' "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	grep -q '^address=/xvcf2.xboxlive.cn/198.51.100.8$' "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	grep -q '^address=/5.xb.delivery.microsoft.com/198.51.100.11$' "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	grep -qxF "$REDIR_MARK" "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	grep -q '^srv-host=assets-srvs-net.trafficmanager.net,assets1.xboxlive.com,80,0,0$' "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	if grep -q '^address=/assets1.xboxlive.com/219.152.87.113$' "$tmp" ||
		grep -q '^address=/xvcf[12]\.xboxlive\.cn/219.152.87.113$' "$tmp" ||
		grep -q 'dlassets.xboxlive.com' "$tmp"; then
		DOMAINS=$old
		REDIR_MAP=$old_map
		rm -f "$tmp" "$map" "$dom"
		echo "com and xvcf.cn must not share the cdn address" >&2
		return 1
	fi
	render_dns 219.152.87.113 '' 0 "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	if grep -qxF "$REDIR_MARK" "$tmp" || grep -q 'xboxlive.com/' "$tmp" || grep -q 'xvcf[12]\.xboxlive\.cn' "$tmp" || grep -q '^srv-host=' "$tmp"; then
		DOMAINS=$old
		REDIR_MAP=$old_map
		rm -f "$tmp" "$map" "$dom"
		echo "pin off still rewrote redirected names" >&2
		return 1
	fi
	grep -q '^address=/assets1.xboxlive.cn/219.152.87.113$' "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	render_dns '' 203.0.113.10 1 "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	grep -q '^address=/dlassets.xboxlive.com/198.51.100.9$' "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	grep -q '^address=/dlassets.xboxlive.cn/203.0.113.10$' "$tmp" || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom"; return 1; }
	if grep -q 'assets1.xboxlive.com' "$tmp" || grep -q '^srv-host=' "$tmp"; then
		DOMAINS=$old
		REDIR_MAP=$old_map
		rm -f "$tmp" "$map" "$dom"
		echo "legacy redirect included primary com" >&2
		return 1
	fi
	# IPv6 off must not suppress AAAA.
	( setting_ipv6_mode() { printf 'off\n'; }
	  REDIR_MAP=$map
	  DOMAINS=$share/domains
	  render_dns 219.152.87.113 '' 1 "$tmp.off"
	  grep -q '^local=/' "$tmp.off" && exit 1
	  grep -q '^address=/assets1.xboxlive.com/198.51.100.1$' "$tmp.off" || exit 1
	) || { DOMAINS=$old; REDIR_MAP=$old_map; rm -f "$tmp" "$map" "$dom" "$tmp.off"; return 1; }
	# Alias assignment and origin/HTTPS separation.
	printf 'assets1.xboxlive.com\tprimary\tglobal\nxvcf1.xboxlive.cn\tprimary\talias\n' > "$dom"
	( DOMAINS=$dom REDIR_MAP=$map2 REDIR_ORIGINS=$origins
	  redirect_net_overlaps_lan() { return 1; }
	  setting_redirect_net() { printf '198.51.100.0/24\n'; }
	  resolve_origin() { printf '23.1.1.99\n'; }
	  build_redirect_map 219.152.87.113 '' 1 || exit 1
	  grep -q '^assets1.xboxlive.com[[:space:]]198.51.100.1[[:space:]]23.1.1.99$' "$map2" || exit 1
	  grep -q '^xvcf1.xboxlive.cn[[:space:]]198.51.100.2[[:space:]]-$' "$map2" || exit 1
	) || { DOMAINS=$old; REDIR_MAP=$old_map; REDIR_ORIGINS=$old_origins; rm -f "$tmp" "$map" "$dom"; return 1; }
	DOMAINS=$old
	REDIR_MAP=$old_map
	REDIR_ORIGINS=$old_origins
	rm -f "$tmp" "$map" "$dom" "$map2" "$origins" "$tmp.off"
	echo PASS redirect
}

cmd_check() {
	local share policy roster
	share=$(share_dir)
	policy=$POLICY
	roster=$ROSTER
	[ -f "$policy" ] || policy="$share/policy"
	[ -f "$roster" ] || roster="$share/roster"
	/bin/sh "$policy" selftest || exit 1
	/bin/sh "$roster" selftest || exit 1
	redirect_selftest || exit 1
	valid_path "$LEGACY_SAMPLE" || exit 1
	[ "$(probe_host legacy)" = "dlassets.xboxlive.cn" ] || exit 1
	[ "$(probe_com_host assets1.xboxlive.cn)" = "assets1.xboxlive.com" ] || exit 1
	[ "$(probe_com_host dlassets.xboxlive.cn)" = "dlassets.xboxlive.com" ] || exit 1
	[ "$(probe_cn_host assets1.xboxlive.com)" = "assets1.xboxlive.cn" ] || exit 1
	[ "$(probe_cn_host dlassets2.xboxlive.com)" = "dlassets.xboxlive.cn" ] || exit 1
	t1=$(mktemp) || exit 1
	t2=$(mktemp) || exit 1
	printf '198.51.100.1\t206\t1000\t1\t1\t100\tcn1\th\tL\n' > "$t1"
	printf '198.51.100.1\t206\t900\t1\t1\t100\tcn1\th\tL\n' > "$t2"
	SCHEME=com
	PREV_SCHEME=cn
	HISTORY=$t1
	RESULTS=$t2
	[ "$(compare_com)" = "1 0.900 0.900 0.900" ] || { rm -f "$t1" "$t2"; exit 1; }
	rm -f "$t1" "$t2"
	valid_redirect_net 198.51.100.0/24 || exit 1
	valid_redirect_net 198.51.100.1/24 && exit 1
	valid_redirect_net 0.0.0.0/24 && exit 1
	usable_origin_ipv4 23.1.1.1 || exit 1
	usable_origin_ipv4 198.18.88.80 && exit 1
	usable_origin_ipv4 198.51.100.1 && exit 1
	usable_origin_ipv4 192.168.1.1 && exit 1
	t3=$(mktemp) || exit 1
	printf 'assets1.xboxlive.com\t198.51.100.1\t23.1.1.1\nxvcf1.xboxlive.cn\t198.51.100.2\t-\n' > "$t3"
	old_map=$REDIR_MAP
	REDIR_MAP=$t3
	nft_rules > /tmp/xboxaccel.nft.preview || { REDIR_MAP=$old_map; rm -f "$t3"; exit 1; }
	grep -q 'set redirect_v4' /tmp/xboxaccel.nft.preview || { REDIR_MAP=$old_map; rm -f "$t3"; exit 1; }
	grep -q 'map https4' /tmp/xboxaccel.nft.preview || { REDIR_MAP=$old_map; rm -f "$t3"; exit 1; }
	grep -q 'tcp dport 443 dnat' /tmp/xboxaccel.nft.preview || { REDIR_MAP=$old_map; rm -f "$t3"; exit 1; }
	REDIR_MAP=$old_map
	rm -f "$t3" /tmp/xboxaccel.nft.preview
	old_domains=$DOMAINS
	DOMAINS="$share/domains"
	t4=$(mktemp) || exit 1
	i=1
	while [ "$i" -le 10 ]; do
		printf '23.1.1.%s\tL\tassets1.xboxlive.cn\tcn1\n' "$i" >> "$t4"
		i=$((i + 1))
	done
	[ "$(nodes_validate "$t4" | awk 'END { print NR + 0 }')" = 10 ] || { DOMAINS=$old_domains; rm -f "$t4"; exit 1; }
	printf '10.0.0.1\tbad\tassets1.xboxlive.cn\tcn1\n' >> "$t4"
	nodes_validate "$t4" >/dev/null || { DOMAINS=$old_domains; rm -f "$t4"; exit 1; }
	t5=$(mktemp) || { DOMAINS=$old_domains; rm -f "$t4"; exit 1; }
	printf '23.1.1.1\tL\tassets1.xboxlive.cn\tcn1\n10.0.0.1\tbad\tassets1.xboxlive.cn\tcn1\n' > "$t5"
	nodes_validate "$t5" >/dev/null && { DOMAINS=$old_domains; rm -f "$t4" "$t5"; exit 1; }
	DOMAINS=$old_domains
	rm -f "$t4" "$t5"
	public_ipv4 203.0.113.10 || exit 1
	public_ipv4 8.8.8.8 || exit 1
	public_ipv4 100.128.0.1 || exit 1
	public_ipv4 172.15.1.1 || exit 1
	public_ipv4 172.32.1.1 || exit 1
	public_ipv4 192.168.1.1 && exit 1
	public_ipv4 10.0.0.1 && exit 1
	public_ipv4 127.0.0.1 && exit 1
	public_ipv4 172.16.5.1 && exit 1
	public_ipv4 100.64.1.1 && exit 1
	public_ipv4 0.0.0.0 && exit 1
	public_ipv4 224.0.0.1 && exit 1
	public_ipv4 255.255.255.255 && exit 1
	echo PASS public
}

usage() {
	echo "usage: xboxaccel {apply|clear|repair|refresh|test [routine|thorough] [carrier] [cn|com]|test-bg sweep carrier [cn|com]|tick|use primary|legacy ip|probe ip [cn|com]|probe-bg ip [cn|com]|stop|preview [primary] [legacy]|nft-preview|nodes-update [url]|nodes-status|nodes-clear|check|log [n]|log clear|log conn [clear]}"
	exit 1
}

case "${1:-}" in
	apply) cmd_apply ;;
	clear) cmd_clear ;;
	repair) cmd_repair ;;
	test) cmd_test "$2" "$3" "$4" ;;
	test-bg)
		sweep=$2
		carrier=$3
		scheme=$4
		case "$sweep" in
			routine|thorough) ;;
			*) sweep=thorough ;;
		esac
		case "$carrier" in
			any|telecom|unicom|mobile) ;;
			*) carrier=$(setting_carrier) ;;
		esac
		case "$scheme" in
			cn|com) ;;
			*) scheme=$(setting_scheme) ;;
		esac
		exec 8>"$LOCK"
		if ! flock -n 8; then
			echo busy
			exit 0
		fi
		flock -u 8
		if start-stop-daemon -S -b -x /usr/sbin/xboxaccel -- test "$sweep" "$carrier" "$scheme"; then
			exit 0
		fi
		/usr/sbin/xboxaccel test "$sweep" "$carrier" "$scheme" >/tmp/xboxaccel.test.log 2>&1 </dev/null &
		exit 0
		;;
	tick) cmd_tick ;;
	use) cmd_use "$2" "$3" ;;
	probe) cmd_probe "$2" "$3" ;;
	probe-bg)
		ip=$2
		scheme=$3
		public_ipv4 "$ip" || {
			echo "这个地址不是公网 IPv4" >&2
			exit 1
		}
		case "$scheme" in
			cn|com) ;;
			*) scheme=$(setting_scheme) ;;
		esac
		exec 8>"$LOCK"
		if ! flock -n 8; then
			echo busy
			exit 0
		fi
		flock -u 8
		if start-stop-daemon -S -b -x /usr/sbin/xboxaccel -- probe "$ip" "$scheme"; then
			exit 0
		fi
		/usr/sbin/xboxaccel probe "$ip" "$scheme" >/tmp/xboxaccel.test.log 2>&1 </dev/null &
		exit 0
		;;
	stop) cmd_stop ;;
	refresh) cmd_refresh ;;
	preview) cmd_preview "$2" "$3" ;;
	nft-preview) cmd_nft_preview "$2" ;;
	nodes-update) cmd_nodes_update "$2" ;;
	nodes-status) cmd_nodes_status ;;
	nodes-clear) cmd_nodes_clear ;;
	check) cmd_check ;;
	log) cmd_log "$2" "$3" ;;
	*) usage ;;
esac
